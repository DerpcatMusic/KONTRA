[package]
name = "moose-mui"
version = "7.0.0"
edition = "2024"
license = "LicenseRef-TruceLicense-1.0"
# MUI needs 1.98.
rust-version = "1.98"
repository = "https://github.com/Matari-Audio/moose"
homepage = "https://github.com/Matari-Audio/moose"
description = "MUI editors for moose plugins: MuiEditor and the parameter Bridge"
keywords = ["audio", "plugin", "gui", "mui"]
categories = ["multimedia::audio", "gui"]
# Git dependencies (MUI is not on crates.io) keep this off the registry.
publish = false

[dependencies]
moose-core = { git = "https://github.com/Matari-Audio/moose", rev = "bffa4677d0b82119d38566ce7e932dc5c463d497" }
moose-params = { git = "https://github.com/Matari-Audio/moose", rev = "bffa4677d0b82119d38566ce7e932dc5c463d497" }
mui = { git = "https://github.com/Matari-Audio/MUI", features = ["gpu-effects"] }
# Keep the Rust import alias stable while separating the custom host package
# from upstream mui-baseview, whose public native bridges it now consumes.
mui-baseview = { package = "kontra-native-host", path = "../mui-baseview" }
# baseview's parent handle is raw-window-handle 0.6.
raw-window-handle = "0.6"

[dev-dependencies]
moose = { git = "https://github.com/Matari-Audio/moose", rev = "bffa4677d0b82119d38566ce7e932dc5c463d497", default-features = false }
keyboard-types = { version = "0.8", default-features = false }

