name: CI

# Keep the workflow present for every PR. Only known documentation-only changes
# skip expensive jobs; `CI required` still reports success/failure.
# Public main pushes run this exact workflow through Nightly in release mode.
# PR/merge-group checks remain independent; avoid a second ordinary CI push run.
on:
  pull_request:
  merge_group:
  workflow_dispatch:
    inputs:
      release_validation:
        description: Test the shipping ThinLTO profile (slower)
        type: boolean
        default: true
  workflow_call:
    inputs:
      release_validation:
        type: boolean
        default: false

permissions:
  contents: read

env:
  CARGO_TERM_COLOR: always
  CARGO_INCREMENTAL: 0
  APP_GIT_REVISION: ${{ github.sha }}
  MUI_REPORTING_DISABLED: "1"
  CARGO_TARGET_DIR: target
  # Snapshots call this same workflow at their exact source commit, in release mode.
  CI_PROFILE: ${{ inputs.release_validation && 'release' || 'ci' }}
  # First-party crates (cargo test/clippy at the workspace root covers only the root package).
  CRATES: >-
    -p kontakto -p sampler-core -p sampler-ir -p sampler-simd -p sampler-pool -p sampler-ksp
    -p sampler-kontakt -p sampler-uvi -p sampler-midi -p sampler-native -p sampler-ui-ir
    -p sampler-perf

jobs:
  changes:
    runs-on: ubuntu-24.04
    timeout-minutes: 5
    outputs:
      code: ${{ steps.changes.outputs.code }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          ref: ${{ github.sha }}
          fetch-depth: 0
          persist-credentials: false
      - name: Version consistency
        run: |
          python3 tools/version.py check
          python3 tools/version.py self-test
          python3 - <<'PYDEPS'
          import pathlib, tomllib
          packages = tomllib.loads(pathlib.Path('Cargo.lock').read_text())['package']
          windows = lambda package: next(d for d in package['dependencies'] if d.startswith('windows '))
          allocator = next(p for p in packages if p['name'] == 'gpu-allocator')
          for hal in (p for p in packages if p['name'] == 'wgpu-hal'):
              assert windows(allocator) == windows(hal), 'DX12 allocator and wgpu-hal must share Windows interface types'
          PYDEPS
      - name: Classify changes
        id: changes
        env:
          BEFORE: ${{ github.event.pull_request.base.sha || github.event.before }}
          AFTER: ${{ github.sha }}
          FORCE: ${{ inputs.release_validation || (github.event_name != 'push' && github.event_name != 'pull_request') }}
        run: python3 .github/scripts/ci_changes.py
      - name: Workflow syntax and expression checks
        run: bash .github/scripts/check_workflows.sh
      - name: Workflow safety tests
        run: |
          python3 -m unittest discover -s .github/scripts -p 'test_*.py'
          python3 .github/workflows/check_nightly.py

  linux:
    needs: changes
    if: needs.changes.outputs.code == 'true'
    runs-on: ubuntu-24.04
    # Cold release-profile test executables exhausted the former 40-minute job.
    timeout-minutes: 90
    concurrency:
      group: ci-linux-${{ github.workflow }}-${{ github.ref }}
      cancel-in-progress: true
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          ref: ${{ github.sha }}
          persist-credentials: false
      - name: Nightly shipping identity
        if: inputs.release_validation
        shell: bash
        run: |
          export SOURCE_DATE_EPOCH=$(git show -s --format=%ct "$GITHUB_SHA")
          echo "SOURCE_DATE_EPOCH=$SOURCE_DATE_EPOCH" >> "$GITHUB_ENV"
          python3 tools/version.py nightly --write
      - uses: dtolnay/rust-toolchain@6bed0761d98439e5a578e2877258200ad565ba87
        with:
          toolchain: 1.99.0
          components: rustfmt, clippy
      - name: System libraries (X11, OpenGL/Vulkan, ALSA, JACK)
        run: |
          sudo apt-get update
          sudo apt-get install -y --no-install-recommends \
            build-essential pkg-config \
            libx11-dev libx11-xcb-dev libxcb1-dev libxcb-icccm4-dev libxcursor-dev \
            libxkbcommon-dev libxkbcommon-x11-dev libxrandr-dev \
            libgl1-mesa-dev libgl1-mesa-dri libvulkan-dev mesa-vulkan-drivers xvfb xauth \
            libasound2-dev libjack-jackd2-dev
      - name: VST3 native shim editor lifecycle
        run: |
          for test in editor_attach editor_lifetime; do
            g++ -std=c++17 -Wall -Wextra -Werror -pedantic "vendor/moose-vst3/tests/$test.cpp" -o "$RUNNER_TEMP/$test"
            "$RUNNER_TEMP/$test"
          done
      - uses: Swatinem/rust-cache@6323deb102c322ba6fcbdcafc7e3dddab59af2b6 # v2.9.2
        with:
          key: linux-${{ env.CI_PROFILE }}-default
          save-if: ${{ github.ref == 'refs/heads/main' || (github.event_name == 'pull_request' && github.event.pull_request.head.repo.full_name == github.repository) }}
          cache-on-failure: true
      # Existing formatting debt remains advisory; do not reformat unrelated code.
      - name: rustfmt (advisory)
        continue-on-error: true
        run: cargo fmt --all --check
      - name: clippy
        # The root package plus every first-party sampler crate; vendored crates are
        # checked only as dependencies.
        run: cargo clippy --locked --profile "$CI_PROFILE" --all-targets $CRATES
      - name: test
        # library-access is already a default feature; this includes access::*.
        run: |
          cargo test --locked --profile "$CI_PROFILE" $CRATES
          cargo test --locked --profile "$CI_PROFILE" -p kontra-native-host --lib
      - name: Native host lifecycle and software-GL presentation
        env:
          WGPU_BACKEND: gl
          LIBGL_ALWAYS_SOFTWARE: '1'
        run: |
          xvfb-run -a cargo test --locked --profile "$CI_PROFILE" \
            -p kontra-native-host --lib -- --ignored --test-threads=1
          xvfb-run -a cargo test --locked --profile "$CI_PROFILE" \
            -p kontra-native-host --test x11_visibility -- --ignored --test-threads=1

      - name: Build VST3 for native editor validation
        run: |
          python3 - <<'PYPIN'
          import pathlib, re, tomllib
          revision = re.search(r'config.mui_revision = "([0-9a-f]{40})"', pathlib.Path('src/ui/mod.rs').read_text()).group(1)
          sources = {p['source'].split('#')[-1] for p in tomllib.loads(pathlib.Path('Cargo.lock').read_text())['package'] if 'Matari-Audio/MUI' in p.get('source', '')}
          assert sources == {revision}, f'MUI reporting identity differs from compiled sources: {sources}'
          PYPIN
          cargo build --locked --profile "$CI_PROFILE" --lib
          mkdir -p ui-plugin/KONTRA.vst3/Contents/x86_64-linux
          cp "target/$CI_PROFILE/libkontakto.so" ui-plugin/KONTRA.vst3/Contents/x86_64-linux/KONTRA.so
      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9
        with:
          name: kontra-vst3-ui
          path: ui-plugin/
          retention-days: 7
          if-no-files-found: error

  editor:
    needs: [changes, linux]
    if: needs.changes.outputs.code == 'true'
    uses: Matari-Audio/MUI/.github/workflows/plugin-ui.yml@dcf0796082feec053af1418e3a38a302ee61da0a
    with:
      artifact-name: kontra-vst3-ui
      plugin-path: KONTRA.vst3
      require-mui-diagnostics: true

  windows:
    needs: changes
    if: needs.changes.outputs.code == 'true'
    runs-on: windows-2025
    timeout-minutes: 25
    concurrency:
      group: ci-windows-${{ github.workflow }}-${{ github.ref }}
      cancel-in-progress: true
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          ref: ${{ github.sha }}
          persist-credentials: false
      - name: Portable license bundle checks
        run: python3 tools/licenses.py --self-test
      - name: Nightly shipping identity
        if: inputs.release_validation
        shell: bash
        run: |
          export SOURCE_DATE_EPOCH=$(git show -s --format=%ct "$GITHUB_SHA")
          echo "SOURCE_DATE_EPOCH=$SOURCE_DATE_EPOCH" >> "$GITHUB_ENV"
          python3 tools/version.py nightly --write
      - uses: dtolnay/rust-toolchain@6bed0761d98439e5a578e2877258200ad565ba87
        with:
          toolchain: 1.99.0
      - uses: Swatinem/rust-cache@6323deb102c322ba6fcbdcafc7e3dddab59af2b6 # v2.9.2
        with:
          key: windows-${{ env.CI_PROFILE }}-standalone
          save-if: ${{ github.ref == 'refs/heads/main' || (github.event_name == 'pull_request' && github.event.pull_request.head.repo.full_name == github.repository) }}
          cache-on-failure: true
      - name: check
        shell: bash
        run: cargo check --locked --profile "$CI_PROFILE" --all-targets --features standalone

  macos:
    needs: changes
    if: needs.changes.outputs.code == 'true'
    runs-on: macos-15
    timeout-minutes: 25
    concurrency:
      group: ci-macos-${{ github.workflow }}-${{ github.ref }}
      cancel-in-progress: true
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          ref: ${{ github.sha }}
          persist-credentials: false
      - name: Universal installer orchestration checks
        run: |
          python3 tools/licenses.py --self-test
          python3 .github/scripts/test_package_macos.py
          xcrun swiftc -typecheck .github/scripts/check_macos_bundles.swift
          xcrun swift .github/scripts/macos_package_preflight.swift
      - name: Nightly shipping identity
        if: inputs.release_validation
        shell: bash
        run: |
          export SOURCE_DATE_EPOCH=$(git show -s --format=%ct "$GITHUB_SHA")
          echo "SOURCE_DATE_EPOCH=$SOURCE_DATE_EPOCH" >> "$GITHUB_ENV"
          python3 tools/version.py nightly --write
      - uses: dtolnay/rust-toolchain@6bed0761d98439e5a578e2877258200ad565ba87
        with:
          toolchain: 1.99.0
      - uses: Swatinem/rust-cache@6323deb102c322ba6fcbdcafc7e3dddab59af2b6 # v2.9.2
        with:
          key: macos-${{ env.CI_PROFILE }}-standalone
          save-if: ${{ github.ref == 'refs/heads/main' || (github.event_name == 'pull_request' && github.event.pull_request.head.repo.full_name == github.repository) }}
          cache-on-failure: true
      - name: check
        shell: bash
        run: cargo check --locked --profile "$CI_PROFILE" --all-targets --features standalone

  required:
    name: CI required
    if: always()
    needs: [changes, linux, windows, macos, editor]
    runs-on: ubuntu-24.04
    timeout-minutes: 5
    steps:
      - name: Require every applicable check
        env:
          CHANGES: ${{ needs.changes.result }}
          CODE: ${{ needs.changes.outputs.code }}
          LINUX: ${{ needs.linux.result }}
          WINDOWS: ${{ needs.windows.result }}
          MACOS: ${{ needs.macos.result }}
          EDITOR: ${{ needs.editor.result }}
        run: |
          test "$CHANGES" = success
          if [ "$CODE" = true ]; then
            test "$LINUX" = success
            test "$WINDOWS" = success
            test "$MACOS" = success
            test "$EDITOR" = success
          else
            test "$CODE" = false
            test "$LINUX" = skipped
            test "$WINDOWS" = skipped
            test "$MACOS" = skipped
            test "$EDITOR" = skipped
          fi
