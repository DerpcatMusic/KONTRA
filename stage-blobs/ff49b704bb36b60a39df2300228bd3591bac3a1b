[package]
name = "moose-core"
version = "7.0.0"
repository = "https://github.com/Matari-Audio/moose"
homepage = "https://github.com/Matari-Audio/moose"
edition = "2024"
license = "LicenseRef-TruceLicense-1.0"
rust-version = "1.92"
description = "Core types for the moose audio plugin framework"

[features]
# Paranoid real-time allocation checking: a wrapping global allocator
# flags any allocation the audio thread makes inside `process`. Dev/test
# only - off by default, zero-cost when off.
rt-paranoid = ["dep:backtrace"]
# Model-check the task pool's schedule/drain handshake with loom. Off by
# default, so ordinary builds and CI never compile it. Run the check with:
#   cargo test -p moose-core --features loom loom
loom = ["dep:loom"]

[dependencies]
moose-params = { git = "https://github.com/Matari-Audio/moose", rev = "bffa4677d0b82119d38566ce7e932dc5c463d497" }
# Alloc-free stack capture for the `rt-paranoid` allocation checker: the
# split `trace` (raw walk, no alloc) + `resolve` (symbols, deferred) API
# std's `Backtrace` doesn't expose.
backtrace = { version = "0.3", optional = true }
# `cast` + `slugify` live in `moose-utils` (dependency-free) so
# `cargo-moose` and other build-time consumers can use them without
# inheriting `moose-core`'s `moose-params` + `png` publish chain.
# `moose-core` re-exports both at the crate root for backwards-compat
# with existing `moose_core::cast::*` and `moose_core::slugify` callers.
moose-utils = { git = "https://github.com/Matari-Audio/moose", rev = "bffa4677d0b82119d38566ce7e932dc5c463d497" }
png = "0.18"
# `AtomicCell<T>` backs the lock-free `#[persist]` path for `Copy`
# config fields (re-exported from the prelude). Small types stay
# genuinely atomic; larger ones fall back to a private lock.
crossbeam-utils = "0.8"

# Lock-free bounded MPMC queue backing the managed background-task pool
# (`tasks`): the audio thread pushes tasks wait-free, pool workers drain.
crossbeam-queue = "0.3"

# Model checker for the task pool's schedule/drain handshake, behind the
# off-by-default `loom` feature (see `[features]`).
loom = { version = "0.7", optional = true }

# `pin_current_module` (tasks) pins the plugin DLL via GetModuleHandleExW.
[target.'cfg(windows)'.dependencies]
windows-sys = { version = "0.61", features = ["Win32_Foundation", "Win32_System_LibraryLoader"] }

[lints.rust]
unexpected_cfgs = { level = "warn", check-cfg = ['cfg(feature, values("cargo-clippy"))'] }

[lints.clippy]
pedantic = { level = "warn", priority = -1 }
# New in clippy 1.98 (style); `as_chunks` would churn every SIMD kernel.
chunks_exact_to_as_chunks = "allow"
