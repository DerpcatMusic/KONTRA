+    /// Audit-only idle measurement, also valid for an initial page without a knob.
+    #[test]
+    #[ignore = "set KONTRA_UI_BENCH_PATCH"]
+    fn audit_ui_v1_idle_frames() {
+        use moose::mui::mui::vello::{self, vello_cpu::{Pixmap, RenderContext, Resources}};
+        let patch=PathBuf::from(std::env::var_os("KONTRA_UI_BENCH_PATCH").expect("patch"));
+        let start=Instant::now();
+        let instrument=Arc::new(import::read_program(&patch,0).unwrap());
+        let read_ms=start.elapsed().as_secs_f64()*1000.;
+        let start=Instant::now();
+        let mut trace=crate::diagnostics::LoadTrace::new(&patch,0,Some(0));
+        let part=audit_one(&instrument,&mut Found::default(),&mut trace).expect("performance UI");
+        println!("AUDIT_V1 read_ms={read_ms:.3} setup_ms={:.3} controls={} pictures={}",start.elapsed().as_secs_f64()*1000.,part.interface.as_ref().unwrap().controls.len(),part.pictures.len());
+        let shown=perf_view::layout(part.interface.as_ref().unwrap(),&part.pictures);
+        println!("AUDIT_V1 visible={} continuous={} wallpaper={}",shown.len(),shown.iter().filter(|s|matches!(s.kind,Kind::Knob|Kind::Slider)).count(),part.wallpaper.is_some());
+        for mode in [1,3] {
+            let p=Arc::new(SamplerParams::new());
+            p.selection.write().unwrap().parts.push(Part{path:patch.to_string_lossy().into(),view:mode,..Default::default()});
+            p.shared.view.lock().unwrap().parts[0]=part.clone();
+            let mut ui=theme::ui();
+            let mut bridge=Bridge::new(p.clone());
+            let mut draw=build(&p,Arc::default(),Arc::default(),Arc::default(),Arc::default());
+            let (w,h)=(1180,900);
+            let mut ctx=RenderContext::new(w,h);
+            let mut resources=Resources::default();
+            let mut cache=vello::Cache::default();
+            let mut pix=Pixmap::new(w,h);
+            let mut timings:[Vec<f64>;6]=Default::default();
+            for frame in 0..32 {
+                fitted::ready();
+                let a=Instant::now();
+                let tree=draw(&mut ui,&mut bridge);
+                let b=Instant::now();
+                ui.frame(tree,Some(Size::new(w as f64,h as f64)),Input::default(),1./60.).unwrap();
+                let c=Instant::now();
+                let scene=ui.scene().unwrap().clone();
+                let d=Instant::now();
+                ctx.reset();
+                vello::paint(&mut vello::Cpu{ctx:&mut ctx,resources:&mut resources,cache:&mut cache},&scene,vello::kurbo::Affine::IDENTITY).unwrap();
+                ctx.flush();
+                let e=Instant::now();
+                ctx.render(&mut pix,&mut resources);
+                let f=Instant::now();
+                if frame>=8 {for(t,(start,end))in timings.iter_mut().zip([(a,b),(b,c),(c,d),(d,e),(e,f),(a,f)]){t.push((end-start).as_secs_f64()*1000.);}}
+            }
+            for(stage,mut t)in ["build","layout","scene_clone","cpu_paint","cpu_raster","total"].into_iter().zip(timings){
+                t.sort_by(f64::total_cmp);
+                println!("AUDIT_V1 mode={mode} stage={stage} n={} mean_ms={:.3} median_ms={:.3} p99_ms={:.3}",t.len(),t.iter().sum::<f64>()/t.len() as f64,t[t.len()/2],t[t.len()-1]);
+            }
+            if let Some(dir)=std::env::var_os("KONTRA_AUDIT_UI_SHOTS") {
+                let to=PathBuf::from(dir).join(format!("{}-v1-{mode}.png",patch.file_stem().unwrap().to_string_lossy()));
+                shot(&part,mode,&to).unwrap();
+            }
+        }
+    }
+
     /// Opt-in local measurement; prints timings/counts, never library payloads.
     #[test]
     #[ignore = "set KONTRA_UI_BENCH_PATCH to a locally owned instrument"]
