#!/bin/bash
# Register the signed app's imported package types in the active user's context.
# Never add FinderInfo to signed code (Apple QA1940).
set -euo pipefail
[ "${3:-/}" = / ] || exit 0
user=$(/usr/bin/stat -f %Su /dev/console)
case "$user" in root|loginwindow|_mbsetupuser) echo 'Package types register when the installed app is opened by a user.'; exit 0 ;; esac
uid=$(/usr/bin/id -u "$user")
/bin/launchctl asuser "$uid" /usr/bin/sudo -u "$user" \
  /System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister \
  -f /Applications/KONTRA2.app
echo "Registered KONTRA package types for active user UID $uid."
