# Kontakt 8.13: what each control reads for the range, default, label, automation and drag
# parameters the manual lists for it, unset and after a set. A knob, slider or value edit reads
# its declared range whatever a later write says, and its default reads the minimum until set.
# A slider's drag events and an xy pad's automation id and label read unset after a set.
# Run: ksp_probe.py "ANALOG STRINGS.nki" this-file > control_pars_12.measured
# KONTRA replays it: crates/app/host/tests/oracle_probes.rs.
S declare ui_knob $kn(0, 100, 1)
S declare ui_slider $sl(10, 90)
S declare ui_switch $sw
S declare ui_value_edit $ve(-5, 50, 1)
S declare ui_xy ?xy[2]
S declare ui_mouse_area $ma
S declare ui_level_meter $lm
S declare ui_menu $mn
S add_menu_item($mn, "a", 0)
S add_menu_item($mn, "b", 1)
R knob_min get_control_par(get_ui_id($kn), $CONTROL_PAR_MIN_VALUE)
R knob_max get_control_par(get_ui_id($kn), $CONTROL_PAR_MAX_VALUE)
R knob_default get_control_par(get_ui_id($kn), $CONTROL_PAR_DEFAULT_VALUE)
R knob_auto get_control_par(get_ui_id($kn), $CONTROL_PAR_AUTOMATION_ID)
S set_control_par(get_ui_id($kn), $CONTROL_PAR_DEFAULT_VALUE, 40)
R knob_default_set get_control_par(get_ui_id($kn), $CONTROL_PAR_DEFAULT_VALUE)
R knob_value_after_default get_control_par(get_ui_id($kn), $CONTROL_PAR_VALUE)
S set_control_par(get_ui_id($kn), $CONTROL_PAR_MAX_VALUE, 200)
R knob_max_set get_control_par(get_ui_id($kn), $CONTROL_PAR_MAX_VALUE)
S set_control_par(get_ui_id($kn), $CONTROL_PAR_MIN_VALUE, 20)
R knob_min_set get_control_par(get_ui_id($kn), $CONTROL_PAR_MIN_VALUE)
R knob_value_after_min get_control_par(get_ui_id($kn), $CONTROL_PAR_VALUE)
R slider_min get_control_par(get_ui_id($sl), $CONTROL_PAR_MIN_VALUE)
R slider_max get_control_par(get_ui_id($sl), $CONTROL_PAR_MAX_VALUE)
R slider_default get_control_par(get_ui_id($sl), $CONTROL_PAR_DEFAULT_VALUE)
R slider_auto get_control_par(get_ui_id($sl), $CONTROL_PAR_AUTOMATION_ID)
R slider_drag get_control_par(get_ui_id($sl), $CONTROL_PAR_RECEIVE_DRAG_EVENTS)
T slider_label get_control_par_str(get_ui_id($sl), $CONTROL_PAR_LABEL)
S set_control_par(get_ui_id($sl), $CONTROL_PAR_MAX_VALUE, 50)
R slider_max_set get_control_par(get_ui_id($sl), $CONTROL_PAR_MAX_VALUE)
R slider_value_after_max get_control_par(get_ui_id($sl), $CONTROL_PAR_VALUE)
S set_control_par(get_ui_id($sl), $CONTROL_PAR_MIN_VALUE, 30)
R slider_min_set get_control_par(get_ui_id($sl), $CONTROL_PAR_MIN_VALUE)
R slider_value_after_min get_control_par(get_ui_id($sl), $CONTROL_PAR_VALUE)
S set_control_par(get_ui_id($sl), $CONTROL_PAR_AUTOMATION_ID, 7)
R slider_auto_set get_control_par(get_ui_id($sl), $CONTROL_PAR_AUTOMATION_ID)
S set_control_par(get_ui_id($sl), $CONTROL_PAR_RECEIVE_DRAG_EVENTS, 1)
R slider_drag_set get_control_par(get_ui_id($sl), $CONTROL_PAR_RECEIVE_DRAG_EVENTS)
S set_control_par_str(get_ui_id($sl), $CONTROL_PAR_LABEL, "lab")
T slider_label_set get_control_par_str(get_ui_id($sl), $CONTROL_PAR_LABEL)
R switch_auto get_control_par(get_ui_id($sw), $CONTROL_PAR_AUTOMATION_ID)
T switch_label get_control_par_str(get_ui_id($sw), $CONTROL_PAR_LABEL)
S set_control_par(get_ui_id($sw), $CONTROL_PAR_AUTOMATION_ID, 9)
R switch_auto_set get_control_par(get_ui_id($sw), $CONTROL_PAR_AUTOMATION_ID)
S set_control_par_str(get_ui_id($sw), $CONTROL_PAR_LABEL, "sw")
T switch_label_set get_control_par_str(get_ui_id($sw), $CONTROL_PAR_LABEL)
T switch_text_after_label get_control_par_str(get_ui_id($sw), $CONTROL_PAR_TEXT)
R value_edit_min get_control_par(get_ui_id($ve), $CONTROL_PAR_MIN_VALUE)
R value_edit_max get_control_par(get_ui_id($ve), $CONTROL_PAR_MAX_VALUE)
S set_control_par(get_ui_id($ve), $CONTROL_PAR_MAX_VALUE, 60)
R value_edit_max_set get_control_par(get_ui_id($ve), $CONTROL_PAR_MAX_VALUE)
S set_control_par(get_ui_id($ve), $CONTROL_PAR_MIN_VALUE, 5)
R value_edit_min_set get_control_par(get_ui_id($ve), $CONTROL_PAR_MIN_VALUE)
R value_edit_value_after_min get_control_par(get_ui_id($ve), $CONTROL_PAR_VALUE)
R xy_auto get_control_par(get_ui_id(?xy), $CONTROL_PAR_AUTOMATION_ID)
T xy_label get_control_par_str(get_ui_id(?xy), $CONTROL_PAR_LABEL)
S set_control_par(get_ui_id(?xy), $CONTROL_PAR_AUTOMATION_ID, 11)
R xy_auto_set get_control_par(get_ui_id(?xy), $CONTROL_PAR_AUTOMATION_ID)
S set_control_par_str(get_ui_id(?xy), $CONTROL_PAR_LABEL, "xy")
T xy_label_set get_control_par_str(get_ui_id(?xy), $CONTROL_PAR_LABEL)
R mouse_area_item get_control_par(get_ui_id($ma), $CONTROL_PAR_SELECTED_ITEM_IDX)
R mouse_area_drag get_control_par(get_ui_id($ma), $CONTROL_PAR_RECEIVE_DRAG_EVENTS)
R level_meter_export get_control_par(get_ui_id($lm), $CONTROL_PAR_MIDI_EXPORT_AREA_IDX)
R level_meter_range get_control_par(get_ui_id($lm), $CONTROL_PAR_RANGE_MAX)
R menu_range get_control_par(get_ui_id($mn), $CONTROL_PAR_RANGE_MAX)
R menu_items get_control_par(get_ui_id($mn), $CONTROL_PAR_NUM_ITEMS)
R menu_selected get_control_par(get_ui_id($mn), $CONTROL_PAR_SELECTED_ITEM_IDX)
