# Control parameter write laws in Kontakt 8.13, after control_pars_1: grid position and size against
# pixels, automation id range, colour and alpha reads, and out-of-range writes.
# Run: ksp_probe.py "ANALOG STRINGS.nki" this-file > control_pars_2.measured
# KONTRA replays it: crates/app/host/tests/oracle_probes.rs.
S declare ui_knob $ka(0, 100, 1)
S declare ui_knob $kb(0, 100, 1)
S declare ui_knob $kc(0, 100, 1)
S declare ui_slider $sl(0, 100)
S declare ui_switch $sw
S declare ui_label $lb(1, 1)
S declare ui_value_edit $ve(0, 100, 1)
S declare ui_level_meter $lm
S declare ui_waveform $wf(6, 6)
S declare ui_wavetable $wt
S declare ui_xy ?xy[4]
S declare ui_file_selector $fs
S declare $a
S declare $b
S declare $c
S declare $w
S declare $x
S $a := get_ui_id($ka)
S $b := get_ui_id($kb)
S $c := get_ui_id($kc)
S $w := get_ui_id($wt)
S $x := get_ui_id(?xy)
R pos_x get_control_par($a, $CONTROL_PAR_POS_X)
R pos_y get_control_par($a, $CONTROL_PAR_POS_Y)
S move_control($ka, 3, 2)
R move_grid_x get_control_par($a, $CONTROL_PAR_GRID_X)
R move_grid_y get_control_par($a, $CONTROL_PAR_GRID_Y)
S set_control_par($a, $CONTROL_PAR_POS_X, 100)
R px100_grid_x get_control_par($a, $CONTROL_PAR_GRID_X)
S set_control_par($a, $CONTROL_PAR_POS_X, 183)
R px183_grid_x get_control_par($a, $CONTROL_PAR_GRID_X)
S set_control_par($a, $CONTROL_PAR_POS_X, 184)
R px184_grid_x get_control_par($a, $CONTROL_PAR_GRID_X)
S set_control_par($a, $CONTROL_PAR_POS_X, 0)
R px0_grid_x get_control_par($a, $CONTROL_PAR_GRID_X)
S set_control_par($a, $CONTROL_PAR_POS_Y, 42)
R py42_grid_y get_control_par($a, $CONTROL_PAR_GRID_Y)
S set_control_par($b, $CONTROL_PAR_GRID_Y, 3)
R gy3_pos_y get_control_par($b, $CONTROL_PAR_POS_Y)
R gy3_grid_y get_control_par($b, $CONTROL_PAR_GRID_Y)
S set_control_par($b, $CONTROL_PAR_GRID_X, 1)
R gx1_pos_x get_control_par($b, $CONTROL_PAR_POS_X)
R gx1_grid_x get_control_par($b, $CONTROL_PAR_GRID_X)
S set_control_par($b, $CONTROL_PAR_GRID_X, 0)
R gx0_pos_x get_control_par($b, $CONTROL_PAR_POS_X)
R gx0_grid_x get_control_par($b, $CONTROL_PAR_GRID_X)
S set_control_par($c, $CONTROL_PAR_WIDTH, 92)
R w92_grid get_control_par($c, $CONTROL_PAR_GRID_WIDTH)
S set_control_par($c, $CONTROL_PAR_WIDTH, 184)
R w184_grid get_control_par($c, $CONTROL_PAR_GRID_WIDTH)
S set_control_par($c, $CONTROL_PAR_WIDTH, 200)
R w200_grid get_control_par($c, $CONTROL_PAR_GRID_WIDTH)
S set_control_par($c, $CONTROL_PAR_HEIGHT, 42)
R h42_grid get_control_par($c, $CONTROL_PAR_GRID_HEIGHT)
S set_control_par($c, $CONTROL_PAR_GRID_WIDTH, 3)
R gw3_width get_control_par($c, $CONTROL_PAR_WIDTH)
R gw3_grid get_control_par($c, $CONTROL_PAR_GRID_WIDTH)
S set_control_par($c, $CONTROL_PAR_GRID_HEIGHT, 3)
R gh3_height get_control_par($c, $CONTROL_PAR_HEIGHT)
S set_control_par($a, $CONTROL_PAR_AUTOMATION_ID, 7)
S set_control_par($a, $CONTROL_PAR_AUTOMATION_ID, 3000)
R aid_7_then_3000 get_control_par($a, $CONTROL_PAR_AUTOMATION_ID)
S set_control_par($a, $CONTROL_PAR_AUTOMATION_ID, 2047)
R aid_2047 get_control_par($a, $CONTROL_PAR_AUTOMATION_ID)
S set_control_par($a, $CONTROL_PAR_AUTOMATION_ID, 2048)
R aid_2048 get_control_par($a, $CONTROL_PAR_AUTOMATION_ID)
S set_control_par($a, $CONTROL_PAR_AUTOMATION_ID, -1)
R aid_neg get_control_par($a, $CONTROL_PAR_AUTOMATION_ID)
R allow_slider get_control_par(get_ui_id($sl), $CONTROL_PAR_ALLOW_AUTOMATION)
R allow_switch get_control_par(get_ui_id($sw), $CONTROL_PAR_ALLOW_AUTOMATION)
R allow_xy get_control_par($x, $CONTROL_PAR_ALLOW_AUTOMATION)
R allow_label get_control_par(get_ui_id($lb), $CONTROL_PAR_ALLOW_AUTOMATION)
S set_control_par(get_ui_id($sl), $CONTROL_PAR_ALLOW_AUTOMATION, 5)
R allow_5 get_control_par(get_ui_id($sl), $CONTROL_PAR_ALLOW_AUTOMATION)
S set_control_par($a, $CONTROL_PAR_UNIT, 6)
R unit_6 get_control_par($a, $CONTROL_PAR_UNIT)
S set_control_par($a, $CONTROL_PAR_UNIT, 7)
R unit_7 get_control_par($a, $CONTROL_PAR_UNIT)
S set_control_par($a, $CONTROL_PAR_UNIT, -1)
R unit_neg get_control_par($a, $CONTROL_PAR_UNIT)
S set_knob_unit($kb, 99)
R knob_unit_99 get_control_par($b, $CONTROL_PAR_UNIT)
S set_control_par($w, $CONTROL_PAR_BG_ALPHA, 300)
R wt_bg_alpha_300 get_control_par($w, $CONTROL_PAR_BG_ALPHA)
S set_control_par($w, $CONTROL_PAR_WAVE_ALPHA, 255)
R wave_alpha_255 get_control_par($w, $CONTROL_PAR_WAVE_ALPHA)
S set_control_par($w, $CONTROL_PAR_WAVE_COLOR, 0ff0000h)
R wave_color_set get_control_par($w, $CONTROL_PAR_WAVE_COLOR)
S set_control_par($w, $CONTROL_PAR_WAVETABLE_ALPHA, 300)
R wavetable_alpha_300 get_control_par($w, $CONTROL_PAR_WAVETABLE_ALPHA)
R wave_end_alpha get_control_par($w, $CONTROL_PAR_WAVE_END_ALPHA)
R wavetable_end_alpha get_control_par($w, $CONTROL_PAR_WAVETABLE_END_ALPHA)
R wt_vis_mode get_control_par($w, $CONTROL_PAR_WT_VIS_MODE)
R wt_bg_color get_control_par($w, $CONTROL_PAR_BG_COLOR)
S set_control_par($w, $CONTROL_PAR_PARALLAX_X, -2000000)
R parallax_x_neg get_control_par($w, $CONTROL_PAR_PARALLAX_X)
R wf_wave_color get_control_par(get_ui_id($wf), $CONTROL_PAR_WAVE_COLOR)
R wf_bg_color get_control_par(get_ui_id($wf), $CONTROL_PAR_BG_COLOR)
S set_control_par(get_ui_id($wf), $CONTROL_PAR_WAVE_CURSOR_COLOR, 5)
R wf_cursor_5 get_control_par(get_ui_id($wf), $CONTROL_PAR_WAVE_CURSOR_COLOR)
S set_control_par(get_ui_id($wf), $CONTROL_PAR_WF_VIS_MODE, 5)
R wf_vis_5 get_control_par(get_ui_id($wf), $CONTROL_PAR_WF_VIS_MODE)
S set_control_par(get_ui_id($wf), $CONTROL_PAR_WF_VIS_MODE, -1)
R wf_vis_neg get_control_par(get_ui_id($wf), $CONTROL_PAR_WF_VIS_MODE)
R lm_on_color get_control_par(get_ui_id($lm), $CONTROL_PAR_ON_COLOR)
R lm_off_color get_control_par(get_ui_id($lm), $CONTROL_PAR_OFF_COLOR)
R lm_overload_color get_control_par(get_ui_id($lm), $CONTROL_PAR_OVERLOAD_COLOR)
R lm_bg_color get_control_par(get_ui_id($lm), $CONTROL_PAR_BG_COLOR)
R lm_vertical get_control_par(get_ui_id($lm), $CONTROL_PAR_VERTICAL)
S set_control_par(get_ui_id($lm), $CONTROL_PAR_PEAK_COLOR, 5)
R peak_5 get_control_par(get_ui_id($lm), $CONTROL_PAR_PEAK_COLOR)
S set_control_par($x, $CONTROL_PAR_MOUSE_BEHAVIOUR_X, -500)
R mouse_x_neg get_control_par($x, $CONTROL_PAR_MOUSE_BEHAVIOUR_X)
S set_control_par($x, $CONTROL_PAR_MOUSE_BEHAVIOUR_X, 6000)
R mouse_x_6000 get_control_par($x, $CONTROL_PAR_MOUSE_BEHAVIOUR_X)
S set_control_par($x, $CONTROL_PAR_ACTIVE_INDEX, -1)
R active_neg get_control_par($x, $CONTROL_PAR_ACTIVE_INDEX)
S set_control_par($x, $CONTROL_PAR_ACTIVE_INDEX, 100)
R active_100 get_control_par($x, $CONTROL_PAR_ACTIVE_INDEX)
S set_control_par(get_ui_id($fs), $CONTROL_PAR_COLUMN_WIDTH, -5)
R column_neg get_control_par(get_ui_id($fs), $CONTROL_PAR_COLUMN_WIDTH)
S set_control_par(get_ui_id($ve), $CONTROL_PAR_VALUEPOS_Y, -5)
R valuepos_neg get_control_par(get_ui_id($ve), $CONTROL_PAR_VALUEPOS_Y)
S set_control_par(get_ui_id($sw), $CONTROL_PAR_DISABLE_TEXT_SHIFTING, 5)
R shifting_5 get_control_par(get_ui_id($sw), $CONTROL_PAR_DISABLE_TEXT_SHIFTING)
S set_control_par(get_ui_id($sw), $CONTROL_PAR_FONT_TYPE_ON, 30)
R font_on_30 get_control_par(get_ui_id($sw), $CONTROL_PAR_FONT_TYPE_ON)
S set_control_par(get_ui_id($sw), $CONTROL_PAR_FONT_TYPE_OFF_PRESSED, -1)
R font_off_pressed_neg get_control_par(get_ui_id($sw), $CONTROL_PAR_FONT_TYPE_OFF_PRESSED)
