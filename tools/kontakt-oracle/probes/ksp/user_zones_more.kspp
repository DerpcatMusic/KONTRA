# User zones in Kontakt 8.13 (run: ksp_probe.py <nki> this-file): the zone parameters a script
# reads but cannot set (sample rate, start mod range, selection, tempo), and the fade clamps
# against a zone's key and velocity width. Needs ANALOG STRINGS and the tone.wav of
# user_zones_sample.kspp (1 s, 44.1 kHz, mono, 440 Hz).
# Not measured: two sessions (2026-11-25) logged no record at all; a set_zone_par of a read-only
# parameter may stop the script. Split it before rerunning.
S declare $z
S declare $r
S set_num_user_zones(1)
S $z := %NI_USER_ZONE_IDS[0]
R e_rate get_zone_par($z, $ZONE_PAR_SAMPLE_RATE)
R e_mod_range get_zone_par($z, $ZONE_PAR_SAMPLE_MOD_RANGE)
R e_selected get_zone_par($z, $ZONE_PAR_SELECTED)
R e_bpm get_zone_par($z, $ZONE_PAR_BPM)
S $r := set_sample($z, "Z:/data/dev/workspace/BuildScratch/oracle-mf/tone.wav")
R l_rate get_zone_par($z, $ZONE_PAR_SAMPLE_RATE)
R l_selected get_zone_par($z, $ZONE_PAR_SELECTED)
R l_bpm get_zone_par($z, $ZONE_PAR_BPM)
S $r := set_zone_par($z, $ZONE_PAR_SAMPLE_RATE, 22050)
R ret_set_rate $r
R rate_after get_zone_par($z, $ZONE_PAR_SAMPLE_RATE)
S $r := set_zone_par($z, $ZONE_PAR_SAMPLE_MOD_RANGE, 1000)
R ret_set_mod_range $r
R mod_range_after get_zone_par($z, $ZONE_PAR_SAMPLE_MOD_RANGE)
S $r := set_zone_par($z, $ZONE_PAR_SELECTED, 1)
R ret_set_selected $r
R selected_after get_zone_par($z, $ZONE_PAR_SELECTED)
S $r := set_zone_par($z, $ZONE_PAR_BPM, 140000)
R ret_set_bpm $r
R bpm_after get_zone_par($z, $ZONE_PAR_BPM)
S set_zone_par($z, $ZONE_PAR_LOW_KEY, 60)
S set_zone_par($z, $ZONE_PAR_HIGH_KEY, 71)
S set_zone_par($z, $ZONE_PAR_LOW_VELO, 1)
S set_zone_par($z, $ZONE_PAR_HIGH_VELO, 100)
S set_zone_par($z, $ZONE_PAR_FADE_LOW_KEY, 5000)
R fade_lk_big get_zone_par($z, $ZONE_PAR_FADE_LOW_KEY)
S set_zone_par($z, $ZONE_PAR_FADE_HIGH_KEY, 4)
R fade_hk_4 get_zone_par($z, $ZONE_PAR_FADE_HIGH_KEY)
R fade_lk_after_hk get_zone_par($z, $ZONE_PAR_FADE_LOW_KEY)
S set_zone_par($z, $ZONE_PAR_FADE_LOW_VELO, -5)
R fade_lv_neg get_zone_par($z, $ZONE_PAR_FADE_LOW_VELO)
S set_zone_par($z, $ZONE_PAR_FADE_HIGH_VELO, 500)
R fade_hv_big get_zone_par($z, $ZONE_PAR_FADE_HIGH_VELO)
S set_zone_par($z, $ZONE_PAR_FADE_LOW_VELO, 30)
R fade_lv_30 get_zone_par($z, $ZONE_PAR_FADE_LOW_VELO)
R fade_hv_after_lv get_zone_par($z, $ZONE_PAR_FADE_HIGH_VELO)
S set_zone_par($z, $ZONE_PAR_SAMPLE_START, -5)
R start_neg get_zone_par($z, $ZONE_PAR_SAMPLE_START)
