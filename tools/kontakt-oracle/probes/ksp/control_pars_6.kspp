# Kontakt 8.13, after control_pars_4/5: grid sizes 0 and negative, grid cells negative, and
# move_control with one coordinate 0 or negative.
# Run: ksp_probe.py "ANALOG STRINGS.nki" this-file > control_pars_6.measured
# KONTRA replays it: crates/app/host/tests/oracle_probes.rs.
S declare ui_label $la(1, 1)
S declare ui_label $lb(1, 1)
S declare ui_knob $m1(0, 100, 1)
S declare ui_knob $m2(0, 100, 1)
S declare ui_knob $m3(0, 100, 1)
S declare ui_knob $m4(0, 100, 1)
S set_control_par(get_ui_id($la), $CONTROL_PAR_GRID_WIDTH, 0)
R gw0 get_control_par(get_ui_id($la), $CONTROL_PAR_GRID_WIDTH)
R gw0_width get_control_par(get_ui_id($la), $CONTROL_PAR_WIDTH)
S set_control_par(get_ui_id($la), $CONTROL_PAR_GRID_WIDTH, -2)
R gw_neg get_control_par(get_ui_id($la), $CONTROL_PAR_GRID_WIDTH)
R gw_neg_width get_control_par(get_ui_id($la), $CONTROL_PAR_WIDTH)
S set_control_par(get_ui_id($la), $CONTROL_PAR_GRID_HEIGHT, 0)
R gh0 get_control_par(get_ui_id($la), $CONTROL_PAR_GRID_HEIGHT)
R gh0_height get_control_par(get_ui_id($la), $CONTROL_PAR_HEIGHT)
S set_control_par(get_ui_id($lb), $CONTROL_PAR_GRID_X, -2)
R gx_neg get_control_par(get_ui_id($lb), $CONTROL_PAR_GRID_X)
R gx_neg_pos get_control_par(get_ui_id($lb), $CONTROL_PAR_POS_X)
R gx_neg_hide get_control_par(get_ui_id($lb), $CONTROL_PAR_HIDE)
S move_control($m1, 0, 3)
R m1_grid_x get_control_par(get_ui_id($m1), $CONTROL_PAR_GRID_X)
R m1_grid_y get_control_par(get_ui_id($m1), $CONTROL_PAR_GRID_Y)
R m1_pos_x get_control_par(get_ui_id($m1), $CONTROL_PAR_POS_X)
R m1_pos_y get_control_par(get_ui_id($m1), $CONTROL_PAR_POS_Y)
R m1_hide get_control_par(get_ui_id($m1), $CONTROL_PAR_HIDE)
S move_control($m2, 3, 0)
R m2_grid_x get_control_par(get_ui_id($m2), $CONTROL_PAR_GRID_X)
R m2_grid_y get_control_par(get_ui_id($m2), $CONTROL_PAR_GRID_Y)
R m2_pos_x get_control_par(get_ui_id($m2), $CONTROL_PAR_POS_X)
R m2_pos_y get_control_par(get_ui_id($m2), $CONTROL_PAR_POS_Y)
R m2_hide get_control_par(get_ui_id($m2), $CONTROL_PAR_HIDE)
S move_control($m3, 2, 2)
S move_control($m3, 0, 0)
R m3_grid_x get_control_par(get_ui_id($m3), $CONTROL_PAR_GRID_X)
R m3_pos_x get_control_par(get_ui_id($m3), $CONTROL_PAR_POS_X)
R m3_hide get_control_par(get_ui_id($m3), $CONTROL_PAR_HIDE)
S move_control($m4, -1, 2)
R m4_grid_x get_control_par(get_ui_id($m4), $CONTROL_PAR_GRID_X)
R m4_pos_x get_control_par(get_ui_id($m4), $CONTROL_PAR_POS_X)
R m4_hide get_control_par(get_ui_id($m4), $CONTROL_PAR_HIDE)
