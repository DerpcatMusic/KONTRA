# Control parameters a script reads back at init in Kontakt 8.13: each one's default on the
# widget the manual names, then what a set (in range, out of range) reads back.
# Run: ksp_probe.py "ANALOG STRINGS.nki" this-file > control_pars_1.measured
# KONTRA replays it: crates/app/host/tests/oracle_probes.rs.
S declare ui_knob $knob_one(0, 100, 1)
S declare ui_knob $knob_two(0, 100, 1)
S declare ui_switch $sw
S declare ui_value_edit $ve(0, 100, 1)
S declare ui_level_meter $lm
S declare ui_waveform $wf(6, 6)
S declare ui_wavetable $wt
S declare ui_xy ?xy[4]
S declare ui_file_selector $fs
S declare $k
S declare $w
S declare $x
S $k := get_ui_id($knob_one)
S $w := get_ui_id($wt)
S $x := get_ui_id(?xy)
R unit get_control_par($k, $CONTROL_PAR_UNIT)
R grid_x get_control_par($k, $CONTROL_PAR_GRID_X)
R grid_y get_control_par($k, $CONTROL_PAR_GRID_Y)
R grid_width get_control_par($k, $CONTROL_PAR_GRID_WIDTH)
R grid_height get_control_par($k, $CONTROL_PAR_GRID_HEIGHT)
R allow_automation get_control_par($k, $CONTROL_PAR_ALLOW_AUTOMATION)
R automation_id get_control_par($k, $CONTROL_PAR_AUTOMATION_ID)
R automation_id_two get_control_par(get_ui_id($knob_two), $CONTROL_PAR_AUTOMATION_ID)
R text_shifting get_control_par(get_ui_id($sw), $CONTROL_PAR_DISABLE_TEXT_SHIFTING)
R font get_control_par(get_ui_id($sw), $CONTROL_PAR_FONT_TYPE)
R font_on get_control_par(get_ui_id($sw), $CONTROL_PAR_FONT_TYPE_ON)
R font_off_pressed get_control_par(get_ui_id($sw), $CONTROL_PAR_FONT_TYPE_OFF_PRESSED)
R font_on_pressed get_control_par(get_ui_id($sw), $CONTROL_PAR_FONT_TYPE_ON_PRESSED)
R font_off_hover get_control_par(get_ui_id($sw), $CONTROL_PAR_FONT_TYPE_OFF_HOVER)
R font_on_hover get_control_par(get_ui_id($sw), $CONTROL_PAR_FONT_TYPE_ON_HOVER)
R valuepos_y get_control_par(get_ui_id($ve), $CONTROL_PAR_VALUEPOS_Y)
R range_min get_control_par(get_ui_id($lm), $CONTROL_PAR_RANGE_MIN)
R range_max get_control_par(get_ui_id($lm), $CONTROL_PAR_RANGE_MAX)
R peak_color get_control_par(get_ui_id($lm), $CONTROL_PAR_PEAK_COLOR)
R wf_vis_mode get_control_par(get_ui_id($wf), $CONTROL_PAR_WF_VIS_MODE)
R wf_bg_alpha get_control_par(get_ui_id($wf), $CONTROL_PAR_BG_ALPHA)
R wf_cursor_color get_control_par(get_ui_id($wf), $CONTROL_PAR_WAVE_CURSOR_COLOR)
R wf_slice_color get_control_par(get_ui_id($wf), $CONTROL_PAR_SLICEMARKERS_COLOR)
R wt_zone get_control_par($w, $CONTROL_PAR_WT_ZONE)
R parallax_x get_control_par($w, $CONTROL_PAR_PARALLAX_X)
R parallax_y get_control_par($w, $CONTROL_PAR_PARALLAX_Y)
R wave_color get_control_par($w, $CONTROL_PAR_WAVE_COLOR)
R wave_alpha get_control_par($w, $CONTROL_PAR_WAVE_ALPHA)
R wave_end_color get_control_par($w, $CONTROL_PAR_WAVE_END_COLOR)
R wavetable_color get_control_par($w, $CONTROL_PAR_WAVETABLE_COLOR)
R wavetable_alpha get_control_par($w, $CONTROL_PAR_WAVETABLE_ALPHA)
R wavetable_end_color get_control_par($w, $CONTROL_PAR_WAVETABLE_END_COLOR)
R wt_bg_alpha get_control_par($w, $CONTROL_PAR_BG_ALPHA)
R mouse_x get_control_par($x, $CONTROL_PAR_MOUSE_BEHAVIOUR_X)
R mouse_y get_control_par($x, $CONTROL_PAR_MOUSE_BEHAVIOUR_Y)
R active_index get_control_par($x, $CONTROL_PAR_ACTIVE_INDEX)
R column_width get_control_par(get_ui_id($fs), $CONTROL_PAR_COLUMN_WIDTH)
# Sets, read back.
S set_control_par($k, $CONTROL_PAR_UNIT, $KNOB_UNIT_HZ)
R unit_hz get_control_par($k, $CONTROL_PAR_UNIT)
S set_control_par($k, $CONTROL_PAR_UNIT, 99)
R unit_99 get_control_par($k, $CONTROL_PAR_UNIT)
S set_control_par($k, $CONTROL_PAR_GRID_X, 3)
R grid_x_3 get_control_par($k, $CONTROL_PAR_GRID_X)
R grid_x_3_pos get_control_par($k, $CONTROL_PAR_POS_X)
S set_control_par($k, $CONTROL_PAR_GRID_WIDTH, 2)
R grid_width_2 get_control_par($k, $CONTROL_PAR_GRID_WIDTH)
R grid_width_2_px get_control_par($k, $CONTROL_PAR_WIDTH)
S set_control_par($k, $CONTROL_PAR_WIDTH, 100)
R width_100_grid get_control_par($k, $CONTROL_PAR_GRID_WIDTH)
S set_control_par($k, $CONTROL_PAR_AUTOMATION_ID, 5)
R automation_id_5 get_control_par($k, $CONTROL_PAR_AUTOMATION_ID)
S set_control_par(get_ui_id($knob_two), $CONTROL_PAR_AUTOMATION_ID, 3000)
R automation_id_3000 get_control_par(get_ui_id($knob_two), $CONTROL_PAR_AUTOMATION_ID)
S set_control_par(get_ui_id($knob_two), $CONTROL_PAR_ALLOW_AUTOMATION, 0)
R allow_automation_0 get_control_par(get_ui_id($knob_two), $CONTROL_PAR_ALLOW_AUTOMATION)
S set_control_par(get_ui_id($sw), $CONTROL_PAR_DISABLE_TEXT_SHIFTING, 1)
R text_shifting_1 get_control_par(get_ui_id($sw), $CONTROL_PAR_DISABLE_TEXT_SHIFTING)
S set_control_par(get_ui_id($sw), $CONTROL_PAR_FONT_TYPE, 4)
R font_4_on get_control_par(get_ui_id($sw), $CONTROL_PAR_FONT_TYPE_ON)
S set_control_par(get_ui_id($sw), $CONTROL_PAR_FONT_TYPE_ON_HOVER, 7)
R font_on_hover_7 get_control_par(get_ui_id($sw), $CONTROL_PAR_FONT_TYPE_ON_HOVER)
S set_control_par(get_ui_id($ve), $CONTROL_PAR_VALUEPOS_Y, 5)
R valuepos_y_5 get_control_par(get_ui_id($ve), $CONTROL_PAR_VALUEPOS_Y)
S set_control_par(get_ui_id($lm), $CONTROL_PAR_RANGE_MIN, 10)
S set_control_par(get_ui_id($lm), $CONTROL_PAR_RANGE_MAX, 5)
R range_min_10 get_control_par(get_ui_id($lm), $CONTROL_PAR_RANGE_MIN)
R range_max_5 get_control_par(get_ui_id($lm), $CONTROL_PAR_RANGE_MAX)
S set_control_par(get_ui_id($wf), $CONTROL_PAR_WF_VIS_MODE, $NI_WF_VIS_MODE_3)
R wf_vis_mode_3 get_control_par(get_ui_id($wf), $CONTROL_PAR_WF_VIS_MODE)
S set_control_par(get_ui_id($wf), $CONTROL_PAR_BG_ALPHA, 300)
R wf_bg_alpha_300 get_control_par(get_ui_id($wf), $CONTROL_PAR_BG_ALPHA)
S set_control_par(get_ui_id($wf), $CONTROL_PAR_BG_ALPHA, -5)
R wf_bg_alpha_neg get_control_par(get_ui_id($wf), $CONTROL_PAR_BG_ALPHA)
S set_control_par($w, $CONTROL_PAR_PARALLAX_X, 2000000)
R parallax_x_big get_control_par($w, $CONTROL_PAR_PARALLAX_X)
S set_control_par($w, $CONTROL_PAR_WAVE_COLOR, 0ff0000h)
R wave_end_after_color get_control_par($w, $CONTROL_PAR_WAVE_END_COLOR)
S set_control_par($w, $CONTROL_PAR_WAVETABLE_COLOR, 000ff00h)
R wavetable_end_after_color get_control_par($w, $CONTROL_PAR_WAVETABLE_END_COLOR)
S set_control_par($w, $CONTROL_PAR_WAVE_ALPHA, 128)
R wave_alpha_128 get_control_par($w, $CONTROL_PAR_WAVE_ALPHA)
S set_control_par($x, $CONTROL_PAR_MOUSE_BEHAVIOUR_X, 1000)
R mouse_x_1000 get_control_par($x, $CONTROL_PAR_MOUSE_BEHAVIOUR_X)
S set_control_par($x, $CONTROL_PAR_ACTIVE_INDEX, 2)
R active_index_2 get_control_par($x, $CONTROL_PAR_ACTIVE_INDEX)
S set_control_par($x, $CONTROL_PAR_ACTIVE_INDEX, 3)
R active_index_3 get_control_par($x, $CONTROL_PAR_ACTIVE_INDEX)
S set_control_par(get_ui_id($fs), $CONTROL_PAR_COLUMN_WIDTH, 180)
R column_width_180 get_control_par(get_ui_id($fs), $CONTROL_PAR_COLUMN_WIDTH)
