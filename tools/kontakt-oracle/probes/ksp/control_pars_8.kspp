# Kontakt 8.13: $CONTROL_PAR_NONE, and the MIDI drag-and-drop pars of a ui_label
# ($CONTROL_PAR_DND_BEHAVIOUR, $CONTROL_PAR_MIDI_EXPORT_AREA_IDX; manual: 512 export areas):
# their defaults, writes in and out of range, and on a control that is not a label.
# Their values measured 0, 40 and 105 (KONTRA keeps them opaque symbols: constants.tsv).
# Run: ksp_probe.py "ANALOG STRINGS.nki" this-file > control_pars_8.measured
# KONTRA replays it: crates/app/host/tests/oracle_probes.rs.
S declare ui_label $lb(1, 1)
S declare ui_label $lc(1, 1)
S declare ui_knob $kn(0, 100, 1)
S declare $l
S $l := get_ui_id($lb)
R none_read get_control_par($l, $CONTROL_PAR_NONE)
S set_control_par($l, $CONTROL_PAR_NONE, 5)
R none_5 get_control_par($l, $CONTROL_PAR_NONE)
R none_5_pos_x get_control_par($l, $CONTROL_PAR_POS_X)
R dnd_default get_control_par($l, $CONTROL_PAR_DND_BEHAVIOUR)
S set_control_par($l, $CONTROL_PAR_DND_BEHAVIOUR, 1)
R dnd_1 get_control_par($l, $CONTROL_PAR_DND_BEHAVIOUR)
S set_control_par($l, $CONTROL_PAR_DND_BEHAVIOUR, 5)
R dnd_5 get_control_par($l, $CONTROL_PAR_DND_BEHAVIOUR)
S set_control_par($l, $CONTROL_PAR_DND_BEHAVIOUR, -1)
R dnd_neg get_control_par($l, $CONTROL_PAR_DND_BEHAVIOUR)
R area_default get_control_par($l, $CONTROL_PAR_MIDI_EXPORT_AREA_IDX)
S set_control_par($l, $CONTROL_PAR_MIDI_EXPORT_AREA_IDX, 7)
R area_7 get_control_par($l, $CONTROL_PAR_MIDI_EXPORT_AREA_IDX)
S set_control_par($l, $CONTROL_PAR_MIDI_EXPORT_AREA_IDX, 511)
R area_511 get_control_par($l, $CONTROL_PAR_MIDI_EXPORT_AREA_IDX)
S set_control_par($l, $CONTROL_PAR_MIDI_EXPORT_AREA_IDX, 512)
R area_512 get_control_par($l, $CONTROL_PAR_MIDI_EXPORT_AREA_IDX)
S set_control_par($l, $CONTROL_PAR_MIDI_EXPORT_AREA_IDX, 100000)
R area_100000 get_control_par($l, $CONTROL_PAR_MIDI_EXPORT_AREA_IDX)
S set_control_par($l, $CONTROL_PAR_MIDI_EXPORT_AREA_IDX, -1)
R area_neg get_control_par($l, $CONTROL_PAR_MIDI_EXPORT_AREA_IDX)
S set_control_par(get_ui_id($lc), $CONTROL_PAR_MIDI_EXPORT_AREA_IDX, -5)
R area_neg5_first get_control_par(get_ui_id($lc), $CONTROL_PAR_MIDI_EXPORT_AREA_IDX)
R knob_dnd get_control_par(get_ui_id($kn), $CONTROL_PAR_DND_BEHAVIOUR)
S set_control_par(get_ui_id($kn), $CONTROL_PAR_DND_BEHAVIOUR, 1)
R knob_dnd_1 get_control_par(get_ui_id($kn), $CONTROL_PAR_DND_BEHAVIOUR)
S set_control_par(get_ui_id($kn), $CONTROL_PAR_MIDI_EXPORT_AREA_IDX, 3)
R knob_area_3 get_control_par(get_ui_id($kn), $CONTROL_PAR_MIDI_EXPORT_AREA_IDX)
