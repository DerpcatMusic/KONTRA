# MEASURED 2026-11-14: tempo guess ($ZONE_PAR_BPM x1000) of a user sample, 44.1 kHz: 0.25 s 960000, 0.5 480000, 1 240000, 2 120000, 3 79999, 4 120000, 6 79999, 8 120000, 12 79999, 16 120000;
# edges in user_bpm_edges.kspp. Law (kontra_plan::guess_bpm): 4, 8, 16 ... beats, the fewest whose tempo reaches 70 BPM; 80 and 160 read one thousandth low.
# BPM Kontakt 8.13 reads for a user sample of each length (run: ksp_probe.py <nki> this-file; wavs from tools/kontakt-oracle/probes/ksp/user_zones.kspp notes: 440 Hz mono 44.1 kHz len_<s>.wav).
S declare $z
S set_num_user_zones(10)
S set_sample(%NI_USER_ZONE_IDS[0], "Z:/data/dev/workspace/BuildScratch/oracle-mf/len_0.25.wav")
S set_sample(%NI_USER_ZONE_IDS[1], "Z:/data/dev/workspace/BuildScratch/oracle-mf/len_0.5.wav")
S set_sample(%NI_USER_ZONE_IDS[2], "Z:/data/dev/workspace/BuildScratch/oracle-mf/len_1.wav")
S set_sample(%NI_USER_ZONE_IDS[3], "Z:/data/dev/workspace/BuildScratch/oracle-mf/len_2.wav")
S set_sample(%NI_USER_ZONE_IDS[4], "Z:/data/dev/workspace/BuildScratch/oracle-mf/len_3.wav")
S set_sample(%NI_USER_ZONE_IDS[5], "Z:/data/dev/workspace/BuildScratch/oracle-mf/len_4.wav")
S set_sample(%NI_USER_ZONE_IDS[6], "Z:/data/dev/workspace/BuildScratch/oracle-mf/len_6.wav")
S set_sample(%NI_USER_ZONE_IDS[7], "Z:/data/dev/workspace/BuildScratch/oracle-mf/len_8.wav")
S set_sample(%NI_USER_ZONE_IDS[8], "Z:/data/dev/workspace/BuildScratch/oracle-mf/len_12.wav")
S set_sample(%NI_USER_ZONE_IDS[9], "Z:/data/dev/workspace/BuildScratch/oracle-mf/len_16.wav")
R bpm_0_25s get_zone_par(%NI_USER_ZONE_IDS[0], $ZONE_PAR_BPM)
R bpm_0_5s get_zone_par(%NI_USER_ZONE_IDS[1], $ZONE_PAR_BPM)
R bpm_1s get_zone_par(%NI_USER_ZONE_IDS[2], $ZONE_PAR_BPM)
R bpm_2s get_zone_par(%NI_USER_ZONE_IDS[3], $ZONE_PAR_BPM)
R bpm_3s get_zone_par(%NI_USER_ZONE_IDS[4], $ZONE_PAR_BPM)
R bpm_4s get_zone_par(%NI_USER_ZONE_IDS[5], $ZONE_PAR_BPM)
R bpm_6s get_zone_par(%NI_USER_ZONE_IDS[6], $ZONE_PAR_BPM)
R bpm_8s get_zone_par(%NI_USER_ZONE_IDS[7], $ZONE_PAR_BPM)
R bpm_12s get_zone_par(%NI_USER_ZONE_IDS[8], $ZONE_PAR_BPM)
R bpm_16s get_zone_par(%NI_USER_ZONE_IDS[9], $ZONE_PAR_BPM)
R len_us_0_25s get_sample_length(%NI_USER_ZONE_IDS[0])
R len_us_0_5s get_sample_length(%NI_USER_ZONE_IDS[1])
R len_us_1s get_sample_length(%NI_USER_ZONE_IDS[2])
R len_us_2s get_sample_length(%NI_USER_ZONE_IDS[3])
R len_us_3s get_sample_length(%NI_USER_ZONE_IDS[4])
R len_us_4s get_sample_length(%NI_USER_ZONE_IDS[5])
R len_us_6s get_sample_length(%NI_USER_ZONE_IDS[6])
R len_us_8s get_sample_length(%NI_USER_ZONE_IDS[7])
R len_us_12s get_sample_length(%NI_USER_ZONE_IDS[8])
R len_us_16s get_sample_length(%NI_USER_ZONE_IDS[9])
