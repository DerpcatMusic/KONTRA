# Kontakt 8.13, after control_pars_2: which store each ui_wavetable colour/alpha parameter reads
# (each set to its own value, then all read), move_control to (0, 0) and (1, 1), position defaults by
# control type, and whether negative VALUEPOS_Y / FONT_TYPE_* writes clamp or are refused.
# Run: ksp_probe.py "ANALOG STRINGS.nki" this-file > control_pars_3.measured
# KONTRA replays it: crates/app/host/tests/oracle_probes.rs.
S declare ui_wavetable $t0
S declare ui_wavetable $t1
S declare ui_wavetable $t2
S declare ui_knob $ka(0, 100, 1)
S declare ui_knob $kb(0, 100, 1)
S declare ui_switch $sw
S declare ui_label $lb(1, 1)
S declare ui_slider $sl(0, 100)
S declare ui_menu $mn
S declare ui_value_edit $ve(0, 100, 1)
R t0_wave_color get_control_par(get_ui_id($t0), $CONTROL_PAR_WAVE_COLOR)
R t0_wave_alpha get_control_par(get_ui_id($t0), $CONTROL_PAR_WAVE_ALPHA)
R t0_wavetable_color get_control_par(get_ui_id($t0), $CONTROL_PAR_WAVETABLE_COLOR)
R t0_wavetable_alpha get_control_par(get_ui_id($t0), $CONTROL_PAR_WAVETABLE_ALPHA)
R t0_bg_color get_control_par(get_ui_id($t0), $CONTROL_PAR_BG_COLOR)
R t0_bg_alpha get_control_par(get_ui_id($t0), $CONTROL_PAR_BG_ALPHA)
R t0_wave_end_color get_control_par(get_ui_id($t0), $CONTROL_PAR_WAVE_END_COLOR)
R t0_wave_end_alpha get_control_par(get_ui_id($t0), $CONTROL_PAR_WAVE_END_ALPHA)
R t0_wavetable_end_color get_control_par(get_ui_id($t0), $CONTROL_PAR_WAVETABLE_END_COLOR)
R t0_wavetable_end_alpha get_control_par(get_ui_id($t0), $CONTROL_PAR_WAVETABLE_END_ALPHA)
S set_control_par(get_ui_id($t1), $CONTROL_PAR_WAVE_COLOR, 11)
S set_control_par(get_ui_id($t1), $CONTROL_PAR_WAVE_ALPHA, 12)
S set_control_par(get_ui_id($t1), $CONTROL_PAR_WAVETABLE_COLOR, 13)
S set_control_par(get_ui_id($t1), $CONTROL_PAR_WAVETABLE_ALPHA, 14)
S set_control_par(get_ui_id($t1), $CONTROL_PAR_BG_COLOR, 15)
S set_control_par(get_ui_id($t1), $CONTROL_PAR_BG_ALPHA, 16)
S set_control_par(get_ui_id($t1), $CONTROL_PAR_WAVE_END_COLOR, 17)
S set_control_par(get_ui_id($t1), $CONTROL_PAR_WAVE_END_ALPHA, 18)
S set_control_par(get_ui_id($t1), $CONTROL_PAR_WAVETABLE_END_COLOR, 19)
S set_control_par(get_ui_id($t1), $CONTROL_PAR_WAVETABLE_END_ALPHA, 20)
R t1_wave_color get_control_par(get_ui_id($t1), $CONTROL_PAR_WAVE_COLOR)
R t1_wave_alpha get_control_par(get_ui_id($t1), $CONTROL_PAR_WAVE_ALPHA)
R t1_wavetable_color get_control_par(get_ui_id($t1), $CONTROL_PAR_WAVETABLE_COLOR)
R t1_wavetable_alpha get_control_par(get_ui_id($t1), $CONTROL_PAR_WAVETABLE_ALPHA)
R t1_bg_color get_control_par(get_ui_id($t1), $CONTROL_PAR_BG_COLOR)
R t1_bg_alpha get_control_par(get_ui_id($t1), $CONTROL_PAR_BG_ALPHA)
R t1_wave_end_color get_control_par(get_ui_id($t1), $CONTROL_PAR_WAVE_END_COLOR)
R t1_wave_end_alpha get_control_par(get_ui_id($t1), $CONTROL_PAR_WAVE_END_ALPHA)
R t1_wavetable_end_color get_control_par(get_ui_id($t1), $CONTROL_PAR_WAVETABLE_END_COLOR)
R t1_wavetable_end_alpha get_control_par(get_ui_id($t1), $CONTROL_PAR_WAVETABLE_END_ALPHA)
S set_control_par(get_ui_id($t2), $CONTROL_PAR_WAVE_ALPHA, 77)
R t2_wave_color get_control_par(get_ui_id($t2), $CONTROL_PAR_WAVE_COLOR)
R t2_wave_alpha get_control_par(get_ui_id($t2), $CONTROL_PAR_WAVE_ALPHA)
R t2_wavetable_color get_control_par(get_ui_id($t2), $CONTROL_PAR_WAVETABLE_COLOR)
R t2_wavetable_alpha get_control_par(get_ui_id($t2), $CONTROL_PAR_WAVETABLE_ALPHA)
R t2_bg_color get_control_par(get_ui_id($t2), $CONTROL_PAR_BG_COLOR)
R t2_bg_alpha get_control_par(get_ui_id($t2), $CONTROL_PAR_BG_ALPHA)
R t2_wave_end_color get_control_par(get_ui_id($t2), $CONTROL_PAR_WAVE_END_COLOR)
R t2_wave_end_alpha get_control_par(get_ui_id($t2), $CONTROL_PAR_WAVE_END_ALPHA)
R t2_wavetable_end_color get_control_par(get_ui_id($t2), $CONTROL_PAR_WAVETABLE_END_COLOR)
R t2_wavetable_end_alpha get_control_par(get_ui_id($t2), $CONTROL_PAR_WAVETABLE_END_ALPHA)
S move_control($ka, 0, 0)
R move00_grid_x get_control_par(get_ui_id($ka), $CONTROL_PAR_GRID_X)
R move00_grid_y get_control_par(get_ui_id($ka), $CONTROL_PAR_GRID_Y)
S move_control($kb, 1, 1)
R move11_grid_x get_control_par(get_ui_id($kb), $CONTROL_PAR_GRID_X)
R move11_pos_x get_control_par(get_ui_id($kb), $CONTROL_PAR_POS_X)
R sw_pos_x get_control_par(get_ui_id($sw), $CONTROL_PAR_POS_X)
R sw_grid_x get_control_par(get_ui_id($sw), $CONTROL_PAR_GRID_X)
R lb_pos_x get_control_par(get_ui_id($lb), $CONTROL_PAR_POS_X)
R lb_grid_x get_control_par(get_ui_id($lb), $CONTROL_PAR_GRID_X)
R sl_pos_x get_control_par(get_ui_id($sl), $CONTROL_PAR_POS_X)
R sl_grid_x get_control_par(get_ui_id($sl), $CONTROL_PAR_GRID_X)
R t0_pos_x get_control_par(get_ui_id($t0), $CONTROL_PAR_POS_X)
R t0_grid_x get_control_par(get_ui_id($t0), $CONTROL_PAR_GRID_X)
R menu_allow get_control_par(get_ui_id($mn), $CONTROL_PAR_ALLOW_AUTOMATION)
R ve_allow get_control_par(get_ui_id($ve), $CONTROL_PAR_ALLOW_AUTOMATION)
S set_control_par(get_ui_id($ve), $CONTROL_PAR_VALUEPOS_Y, 5)
S set_control_par(get_ui_id($ve), $CONTROL_PAR_VALUEPOS_Y, -5)
R valuepos_5_then_neg get_control_par(get_ui_id($ve), $CONTROL_PAR_VALUEPOS_Y)
S set_control_par(get_ui_id($sw), $CONTROL_PAR_FONT_TYPE_OFF_PRESSED, 3)
S set_control_par(get_ui_id($sw), $CONTROL_PAR_FONT_TYPE_OFF_PRESSED, -1)
R font_3_then_neg get_control_par(get_ui_id($sw), $CONTROL_PAR_FONT_TYPE_OFF_PRESSED)
S set_control_par(get_ui_id($sw), $CONTROL_PAR_FONT_TYPE, -1)
R font_type_neg get_control_par(get_ui_id($sw), $CONTROL_PAR_FONT_TYPE)
