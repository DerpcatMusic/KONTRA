# Kontakt 8.13: what every control reads, unset and after a set, for the parameters the KSP UI pages
# use but no measurement covered: geometry, type, modifier keys, value, pictures, drag and drop.
# Run: ksp_probe.py "ANALOG STRINGS.nki" this-file > control_pars_14.measured
# KONTRA replays it: crates/app/host/tests/oracle_probes.rs.
S declare ui_button $bt
S declare ui_file_selector $fs
S declare ui_knob $kn (0, 100, 1)
S declare ui_label $lb (1, 1)
S declare ui_level_meter $lm
S declare ui_menu $mn
S declare ui_mouse_area $ma
S declare ui_panel $pn
S declare ui_slider $sl (0, 100)
S declare ui_switch $sw
S declare ui_table %tb[8] (2, 2, 100)
S declare ui_text_edit @tx
S declare ui_value_edit $ve (0, 100, 1)
S declare ui_waveform $wf (6, 6)
S declare ui_wavetable $wt
S declare ui_xy ?xy[2]
S add_menu_item($mn, "a", 0)
S add_menu_item($mn, "b", 7)
R kn_type get_control_par(get_ui_id($kn), $CONTROL_PAR_TYPE)
R sl_type get_control_par(get_ui_id($sl), $CONTROL_PAR_TYPE)
R mn_type get_control_par(get_ui_id($mn), $CONTROL_PAR_TYPE)
R ma_type get_control_par(get_ui_id($ma), $CONTROL_PAR_TYPE)
R lm_type get_control_par(get_ui_id($lm), $CONTROL_PAR_TYPE)
R fs_height get_control_par(get_ui_id($fs), $CONTROL_PAR_HEIGHT)
R fs_width get_control_par(get_ui_id($fs), $CONTROL_PAR_WIDTH)
R lm_height get_control_par(get_ui_id($lm), $CONTROL_PAR_HEIGHT)
R lm_width get_control_par(get_ui_id($lm), $CONTROL_PAR_WIDTH)
R sl_height get_control_par(get_ui_id($sl), $CONTROL_PAR_HEIGHT)
R sl_width get_control_par(get_ui_id($sl), $CONTROL_PAR_WIDTH)
R tx_height get_control_par(get_ui_id(@tx), $CONTROL_PAR_HEIGHT)
R tx_width get_control_par(get_ui_id(@tx), $CONTROL_PAR_WIDTH)
R pn_height get_control_par(get_ui_id($pn), $CONTROL_PAR_HEIGHT)
R pn_width get_control_par(get_ui_id($pn), $CONTROL_PAR_WIDTH)
R wt_height get_control_par(get_ui_id($wt), $CONTROL_PAR_HEIGHT)
R wt_width get_control_par(get_ui_id($wt), $CONTROL_PAR_WIDTH)
R fs_pos_x get_control_par(get_ui_id($fs), $CONTROL_PAR_POS_X)
R fs_pos_y get_control_par(get_ui_id($fs), $CONTROL_PAR_POS_Y)
R lm_pos_x get_control_par(get_ui_id($lm), $CONTROL_PAR_POS_X)
R lm_pos_y get_control_par(get_ui_id($lm), $CONTROL_PAR_POS_Y)
R tx_pos_x get_control_par(get_ui_id(@tx), $CONTROL_PAR_POS_X)
R tx_pos_y get_control_par(get_ui_id(@tx), $CONTROL_PAR_POS_Y)
R wf_pos_x get_control_par(get_ui_id($wf), $CONTROL_PAR_POS_X)
R wf_pos_y get_control_par(get_ui_id($wf), $CONTROL_PAR_POS_Y)
R xy_pos_x get_control_par(get_ui_id(?xy), $CONTROL_PAR_POS_X)
R xy_pos_y get_control_par(get_ui_id(?xy), $CONTROL_PAR_POS_Y)
R wt_pos_x get_control_par(get_ui_id($wt), $CONTROL_PAR_POS_X)
R wt_pos_y get_control_par(get_ui_id($wt), $CONTROL_PAR_POS_Y)
T bt_picture get_control_par_str(get_ui_id($bt), $CONTROL_PAR_PICTURE)
T lb_picture get_control_par_str(get_ui_id($lb), $CONTROL_PAR_PICTURE)
T sl_picture get_control_par_str(get_ui_id($sl), $CONTROL_PAR_PICTURE)
T sw_picture get_control_par_str(get_ui_id($sw), $CONTROL_PAR_PICTURE)
T ve_picture get_control_par_str(get_ui_id($ve), $CONTROL_PAR_PICTURE)
T mn_picture get_control_par_str(get_ui_id($mn), $CONTROL_PAR_PICTURE)
T xy_cursor_picture get_control_par_str(get_ui_id(?xy), $CONTROL_PAR_CURSOR_PICTURE)
R fs_file_type get_control_par(get_ui_id($fs), $CONTROL_PAR_FILE_TYPE)
R ma_dnd_accept_audio get_control_par(get_ui_id($ma), $CONTROL_PAR_DND_ACCEPT_AUDIO)
S set_control_par(get_ui_id($ma), $CONTROL_PAR_DND_ACCEPT_AUDIO, 1)
R ma_dnd_accept_audio_set get_control_par(get_ui_id($ma), $CONTROL_PAR_DND_ACCEPT_AUDIO)
R ma_dnd_accept_midi get_control_par(get_ui_id($ma), $CONTROL_PAR_DND_ACCEPT_MIDI)
S set_control_par(get_ui_id($ma), $CONTROL_PAR_DND_ACCEPT_MIDI, 1)
R ma_dnd_accept_midi_set get_control_par(get_ui_id($ma), $CONTROL_PAR_DND_ACCEPT_MIDI)
R ma_dnd_accept_array get_control_par(get_ui_id($ma), $CONTROL_PAR_DND_ACCEPT_ARRAY)
S set_control_par(get_ui_id($ma), $CONTROL_PAR_DND_ACCEPT_ARRAY, 1)
R ma_dnd_accept_array_set get_control_par(get_ui_id($ma), $CONTROL_PAR_DND_ACCEPT_ARRAY)
R lb_bg_color get_control_par(get_ui_id($lb), $CONTROL_PAR_BG_COLOR)
R lb_textpos_y get_control_par(get_ui_id($lb), $CONTROL_PAR_TEXTPOS_Y)
S set_control_par(get_ui_id($lb), $CONTROL_PAR_TEXTPOS_Y, 5)
R lb_textpos_y_set get_control_par(get_ui_id($lb), $CONTROL_PAR_TEXTPOS_Y)
R sl_picture_state get_control_par(get_ui_id($sl), $CONTROL_PAR_PICTURE_STATE)
S set_control_par(get_ui_id($sl), $CONTROL_PAR_PICTURE_STATE, 2)
R sl_picture_state_set get_control_par(get_ui_id($sl), $CONTROL_PAR_PICTURE_STATE)
R sw_hide get_control_par(get_ui_id($sw), $CONTROL_PAR_HIDE)
S set_control_par(get_ui_id($sw), $CONTROL_PAR_HIDE, $HIDE_PART_BG)
R sw_hide_set get_control_par(get_ui_id($sw), $CONTROL_PAR_HIDE)
R tx_font_type get_control_par(get_ui_id(@tx), $CONTROL_PAR_FONT_TYPE)
S set_control_par(get_ui_id(@tx), $CONTROL_PAR_FONT_TYPE, 3)
R tx_font_type_set get_control_par(get_ui_id(@tx), $CONTROL_PAR_FONT_TYPE)
R tb_zero_line_color get_control_par(get_ui_id(%tb), $CONTROL_PAR_ZERO_LINE_COLOR)
S set_control_par(get_ui_id(%tb), $CONTROL_PAR_ZERO_LINE_COLOR, 0ff0000h)
R tb_zero_line_color_set get_control_par(get_ui_id(%tb), $CONTROL_PAR_ZERO_LINE_COLOR)
R ve_show_arrows get_control_par(get_ui_id($ve), $CONTROL_PAR_SHOW_ARROWS)
S set_control_par(get_ui_id($ve), $CONTROL_PAR_SHOW_ARROWS, 0)
R ve_show_arrows_set get_control_par(get_ui_id($ve), $CONTROL_PAR_SHOW_ARROWS)
R xy_mouse_mode get_control_par(get_ui_id(?xy), $CONTROL_PAR_MOUSE_MODE)
S set_control_par(get_ui_id(?xy), $CONTROL_PAR_MOUSE_MODE, 1)
R xy_mouse_mode_set get_control_par(get_ui_id(?xy), $CONTROL_PAR_MOUSE_MODE)
R bt_value get_control_par(get_ui_id($bt), $CONTROL_PAR_VALUE)
S set_control_par(get_ui_id($bt), $CONTROL_PAR_VALUE, 1)
R bt_value_set get_control_par(get_ui_id($bt), $CONTROL_PAR_VALUE)
R sw_value get_control_par(get_ui_id($sw), $CONTROL_PAR_VALUE)
S set_control_par(get_ui_id($sw), $CONTROL_PAR_VALUE, 5)
R sw_value_set get_control_par(get_ui_id($sw), $CONTROL_PAR_VALUE)
R mn_value get_control_par(get_ui_id($mn), $CONTROL_PAR_VALUE)
S set_control_par(get_ui_id($mn), $CONTROL_PAR_VALUE, 1)
R mn_value_set get_control_par(get_ui_id($mn), $CONTROL_PAR_VALUE)
R bt_parent_panel get_control_par(get_ui_id($bt), $CONTROL_PAR_PARENT_PANEL)
R pn_parent_panel get_control_par(get_ui_id($pn), $CONTROL_PAR_PARENT_PANEL)
R bt_font_type get_control_par(get_ui_id($bt), $CONTROL_PAR_FONT_TYPE)
R bt_text_alignment get_control_par(get_ui_id($bt), $CONTROL_PAR_TEXT_ALIGNMENT)
R bt_textpos_y get_control_par(get_ui_id($bt), $CONTROL_PAR_TEXTPOS_Y)
R tb_bar_color get_control_par(get_ui_id(%tb), $CONTROL_PAR_BAR_COLOR)
