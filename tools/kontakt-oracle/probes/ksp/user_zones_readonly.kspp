# User zones in Kontakt 8.13 (run: ksp_probe.py <nki> this-file), read-only parameters, split from user_zones_more.kspp
# (needs ANALOG STRINGS and tone.wav of user_zones_sample.kspp). Measured 2026-11-25: see a_user_zones_fades_share_its_width (crates/app/host/tests/script.rs).
S declare $z
S declare $r
S set_num_user_zones(1)
S $z := %NI_USER_ZONE_IDS[0]
S $r := set_sample($z, "Z:/data/dev/workspace/BuildScratch/oracle-mf/tone.wav")
R l_rate get_zone_par($z, $ZONE_PAR_SAMPLE_RATE)
R l_mod_range get_zone_par($z, $ZONE_PAR_SAMPLE_MOD_RANGE)
R l_selected get_zone_par($z, $ZONE_PAR_SELECTED)
R l_bpm get_zone_par($z, $ZONE_PAR_BPM)
S set_zone_par($z, $ZONE_PAR_SELECTED, 1)
R selected_after get_zone_par($z, $ZONE_PAR_SELECTED)
S set_zone_par($z, $ZONE_PAR_SAMPLE_RATE, 22050)
R rate_after get_zone_par($z, $ZONE_PAR_SAMPLE_RATE)
