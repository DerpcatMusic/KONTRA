# Which loop modes a user zone accepts (set_loop_par, then get_loop_par); needs tone.wav as user_zones_sample.kspp.
S declare $z
S set_num_user_zones(1)
S $z := %NI_USER_ZONE_IDS[0]
S set_sample($z, "Z:/data/dev/workspace/BuildScratch/oracle-mf/tone.wav")
S set_loop_par($z, 1, $LOOP_PAR_MODE, 0)
R mode_0 get_loop_par($z, 1, $LOOP_PAR_MODE)
S set_loop_par($z, 1, $LOOP_PAR_MODE, 1)
S set_loop_par($z, 1, $LOOP_PAR_MODE, 1)
R mode_1 get_loop_par($z, 1, $LOOP_PAR_MODE)
S set_loop_par($z, 1, $LOOP_PAR_MODE, 1)
S set_loop_par($z, 1, $LOOP_PAR_MODE, 2)
R mode_2 get_loop_par($z, 1, $LOOP_PAR_MODE)
S set_loop_par($z, 1, $LOOP_PAR_MODE, 1)
S set_loop_par($z, 1, $LOOP_PAR_MODE, 3)
R mode_3 get_loop_par($z, 1, $LOOP_PAR_MODE)
S set_loop_par($z, 1, $LOOP_PAR_MODE, 1)
S set_loop_par($z, 1, $LOOP_PAR_MODE, 4)
R mode_4 get_loop_par($z, 1, $LOOP_PAR_MODE)
S set_loop_par($z, 1, $LOOP_PAR_MODE, 1)
S set_loop_par($z, 1, $LOOP_PAR_MODE, 5)
R mode_5 get_loop_par($z, 1, $LOOP_PAR_MODE)
S set_loop_par($z, 1, $LOOP_PAR_MODE, 1)
S set_loop_par($z, 1, $LOOP_PAR_MODE, 6)
R mode_6 get_loop_par($z, 1, $LOOP_PAR_MODE)
S set_loop_par($z, 1, $LOOP_PAR_MODE, 1)
S set_loop_par($z, 1, $LOOP_PAR_MODE, 8)
R mode_8 get_loop_par($z, 1, $LOOP_PAR_MODE)
S set_loop_par($z, 1, $LOOP_PAR_MODE, 1)
S set_loop_par($z, 1, $LOOP_PAR_MODE, -1)
R mode_-1 get_loop_par($z, 1, $LOOP_PAR_MODE)
S set_loop_par($z, 1, $LOOP_PAR_MODE, 1)
S set_loop_par($z, 2, $LOOP_PAR_LENGTH, 500)
R len_no_mode get_loop_par($z, 2, $LOOP_PAR_LENGTH)
R mode_untouched get_loop_par($z, 2, $LOOP_PAR_MODE)
S set_loop_par($z, 0, $LOOP_PAR_XFADE, 99999)
R xfade_big get_loop_par($z, 0, $LOOP_PAR_XFADE)
S set_loop_par($z, 0, $LOOP_PAR_TUNING, 99999)
R tuning_big get_loop_par($z, 0, $LOOP_PAR_TUNING)
S set_loop_par($z, 0, $LOOP_PAR_START, 99999999)
R start_big get_loop_par($z, 0, $LOOP_PAR_START)
