{ CI fixture: symbols that are never unsupported or stubbed; doctor --strict must pass }
on init
    declare $gain := 0
    declare ui_slider $slider (0, 100)
    set_control_par($slider, $CONTROL_PAR_HIDE, 0)
end on

on ui_control($slider)
    $gain := real($slider) / 100
    set_engine_par($ENGINE_PAR_VOLUME, $gain, 0, 0)
end on

on note
    wait(1000)
    play_note($EVENT_NOTE, $EVENT_VELOCITY, 0, 100000)
end on
