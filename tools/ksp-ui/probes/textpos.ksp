  set_control_par_str(get_ui_id($r10c6), $CONTROL_PAR_PICTURE, "kp_menu")
  set_control_par(get_ui_id($r10c6), $CONTROL_PAR_FONT_TYPE, 13)
  set_control_par(get_ui_id($r10c6), $CONTROL_PAR_TEXT_ALIGNMENT, 2)
  set_control_par(get_ui_id($r10c6), $CONTROL_PAR_TEXTPOS_Y, 500)
  pgs_set_key_val(KLOG, 0, $n)
end on

function log_line
  if ($n < 1023)
    inc($n)
  end if
  pgs_set_key_val(KLOG, 0, $n)
end function

on ui_controls
  !log[$n] := "ucs," & $NI_UI_ID
  call log_line
end on

on persistence_changed
  !log[$n] := "pc"
  call log_line
end on

on pgs_changed
  save_array_str(!log, "Z:/data/dev/workspace/scratch/ksp-ui-trace/textpos.nka")
end on
