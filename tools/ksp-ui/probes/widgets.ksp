  !log[$n] := "init,wave.h," & get_control_par(get_ui_id($wave), $CONTROL_PAR_HEIGHT)
  inc($n)
  set_control_par(get_ui_id($wtable), $CONTROL_PAR_POS_X, 670)
  set_control_par(get_ui_id($wtable), $CONTROL_PAR_POS_Y, 190)
  !log[$n] := "init,wtable.type," & get_control_par(get_ui_id($wtable), $CONTROL_PAR_TYPE)
  inc($n)
  !log[$n] := "init,wtable.w," & get_control_par(get_ui_id($wtable), $CONTROL_PAR_WIDTH)
  inc($n)
  !log[$n] := "init,wtable.h," & get_control_par(get_ui_id($wtable), $CONTROL_PAR_HEIGHT)
  inc($n)
  set_control_par(get_ui_id($files), $CONTROL_PAR_POS_X, 10)
  set_control_par(get_ui_id($files), $CONTROL_PAR_POS_Y, 280)
  !log[$n] := "init,files.type," & get_control_par(get_ui_id($files), $CONTROL_PAR_TYPE)
  inc($n)
  !log[$n] := "init,files.w," & get_control_par(get_ui_id($files), $CONTROL_PAR_WIDTH)
  inc($n)
  !log[$n] := "init,files.h," & get_control_par(get_ui_id($files), $CONTROL_PAR_HEIGHT)
  inc($n)
  set_control_par(get_ui_id($mouse), $CONTROL_PAR_POS_X, 230)
  set_control_par(get_ui_id($mouse), $CONTROL_PAR_POS_Y, 280)
  !log[$n] := "init,mouse.type," & get_control_par(get_ui_id($mouse), $CONTROL_PAR_TYPE)
  inc($n)
  !log[$n] := "init,mouse.w," & get_control_par(get_ui_id($mouse), $CONTROL_PAR_WIDTH)
  inc($n)
  !log[$n] := "init,mouse.h," & get_control_par(get_ui_id($mouse), $CONTROL_PAR_HEIGHT)
  inc($n)
  set_control_par(get_ui_id(@tedit), $CONTROL_PAR_POS_X, 450)
  set_control_par(get_ui_id(@tedit), $CONTROL_PAR_POS_Y, 280)
  !log[$n] := "init,tedit.type," & get_control_par(get_ui_id(@tedit), $CONTROL_PAR_TYPE)
  inc($n)
  !log[$n] := "init,tedit.w," & get_control_par(get_ui_id(@tedit), $CONTROL_PAR_WIDTH)
  inc($n)
  !log[$n] := "init,tedit.h," & get_control_par(get_ui_id(@tedit), $CONTROL_PAR_HEIGHT)
  inc($n)
  set_control_par(get_ui_id($panel), $CONTROL_PAR_POS_X, 670)
  set_control_par(get_ui_id($panel), $CONTROL_PAR_POS_Y, 280)
  !log[$n] := "init,panel.type," & get_control_par(get_ui_id($panel), $CONTROL_PAR_TYPE)
  inc($n)
  !log[$n] := "init,panel.w," & get_control_par(get_ui_id($panel), $CONTROL_PAR_WIDTH)
  inc($n)
  !log[$n] := "init,panel.h," & get_control_par(get_ui_id($panel), $CONTROL_PAR_HEIGHT)
  inc($n)
  add_menu_item($menu, "one", 1)
  add_menu_item($menu, "two", 2)
  set_text($label, "label text")
  set_text($button, "button")
  set_text($switch, "switch")
  pgs_set_key_val(KLOG, 0, $n)
end on

function log_line
  if ($n < 1023)
    inc($n)
  end if
  pgs_set_key_val(KLOG, 0, $n)
end function

on ui_controls
  !log[$n] := "ucs," & $NI_UI_ID
  call log_line
end on

on persistence_changed
  !log[$n] := "pc"
  call log_line
end on

on pgs_changed
  save_array_str(!log, "Z:/data/dev/workspace/scratch/ksp-ui-trace/widgets.nka")
end on

on ui_control ($knob)
  !log[$n] := "uc,knob," & $knob & "," ...
    & get_control_par(get_ui_id($knob), $CONTROL_PAR_KEY_SHIFT) & "," ...
    & get_control_par(get_ui_id($knob), $CONTROL_PAR_KEY_ALT) & "," ...
    & get_control_par(get_ui_id($knob), $CONTROL_PAR_KEY_CONTROL)
  call log_line
end on

