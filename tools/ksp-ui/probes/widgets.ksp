{ KSP UI probe suite, page widgets: written by tools/ksp-ui/gen.py }
on init
  make_perfview
  set_ui_width_px(900)
  set_ui_height_px(380)
  declare !log[1024]
  declare $n := 0
  pgs_create_key(KLOG, 1)
  declare ui_knob $knob(0, 1000, 10)
  make_persistent($knob)
  declare ui_slider $slider(0, 127)
  make_persistent($slider)
  declare ui_button $button
  make_persistent($button)
  declare ui_switch $switch
  make_persistent($switch)
  declare ui_menu $menu
  make_persistent($menu)
  declare ui_label $label(2, 1)
  declare ui_value_edit $vedit(0, 100, 1)
  make_persistent($vedit)
  declare ui_table %table[16](2, 2, 100)
  make_persistent(%table)
  declare ui_xy ?xy[2]
  make_persistent(?xy)
  declare ui_level_meter $meter
  declare ui_waveform $wave(4, 2)
  declare ui_wavetable $wtable
  declare ui_file_selector $files
  make_persistent($files)
  declare ui_mouse_area $mouse
  declare ui_text_edit @tedit
  make_persistent(@tedit)
  declare ui_panel $panel
  set_control_par(get_ui_id($knob), $CONTROL_PAR_POS_X, 10)
  set_control_par(get_ui_id($knob), $CONTROL_PAR_POS_Y, 10)
  !log[$n] := "init,knob.type," & get_control_par(get_ui_id($knob), $CONTROL_PAR_TYPE)
  inc($n)
  !log[$n] := "init,knob.w," & get_control_par(get_ui_id($knob), $CONTROL_PAR_WIDTH)
  inc($n)
  !log[$n] := "init,knob.h," & get_control_par(get_ui_id($knob), $CONTROL_PAR_HEIGHT)
  inc($n)
  set_control_par(get_ui_id($slider), $CONTROL_PAR_POS_X, 230)
  set_control_par(get_ui_id($slider), $CONTROL_PAR_POS_Y, 10)
  !log[$n] := "init,slider.type," & get_control_par(get_ui_id($slider), $CONTROL_PAR_TYPE)
  inc($n)
  !log[$n] := "init,slider.w," & get_control_par(get_ui_id($slider), $CONTROL_PAR_WIDTH)
  inc($n)
  !log[$n] := "init,slider.h," & get_control_par(get_ui_id($slider), $CONTROL_PAR_HEIGHT)
  inc($n)
  set_control_par(get_ui_id($button), $CONTROL_PAR_POS_X, 450)
  set_control_par(get_ui_id($button), $CONTROL_PAR_POS_Y, 10)
  !log[$n] := "init,button.type," & get_control_par(get_ui_id($button), $CONTROL_PAR_TYPE)
  inc($n)
  !log[$n] := "init,button.w," & get_control_par(get_ui_id($button), $CONTROL_PAR_WIDTH)
  inc($n)
  !log[$n] := "init,button.h," & get_control_par(get_ui_id($button), $CONTROL_PAR_HEIGHT)
  inc($n)
  set_control_par(get_ui_id($switch), $CONTROL_PAR_POS_X, 670)
  set_control_par(get_ui_id($switch), $CONTROL_PAR_POS_Y, 10)
  !log[$n] := "init,switch.type," & get_control_par(get_ui_id($switch), $CONTROL_PAR_TYPE)
  inc($n)
  !log[$n] := "init,switch.w," & get_control_par(get_ui_id($switch), $CONTROL_PAR_WIDTH)
  inc($n)
  !log[$n] := "init,switch.h," & get_control_par(get_ui_id($switch), $CONTROL_PAR_HEIGHT)
  inc($n)
  set_control_par(get_ui_id($menu), $CONTROL_PAR_POS_X, 10)
  set_control_par(get_ui_id($menu), $CONTROL_PAR_POS_Y, 100)
  !log[$n] := "init,menu.type," & get_control_par(get_ui_id($menu), $CONTROL_PAR_TYPE)
  inc($n)
  !log[$n] := "init,menu.w," & get_control_par(get_ui_id($menu), $CONTROL_PAR_WIDTH)
  inc($n)
  !log[$n] := "init,menu.h," & get_control_par(get_ui_id($menu), $CONTROL_PAR_HEIGHT)
  inc($n)
  set_control_par(get_ui_id($label), $CONTROL_PAR_POS_X, 230)
  set_control_par(get_ui_id($label), $CONTROL_PAR_POS_Y, 100)
  !log[$n] := "init,label.type," & get_control_par(get_ui_id($label), $CONTROL_PAR_TYPE)
  inc($n)
  !log[$n] := "init,label.w," & get_control_par(get_ui_id($label), $CONTROL_PAR_WIDTH)
  inc($n)
  !log[$n] := "init,label.h," & get_control_par(get_ui_id($label), $CONTROL_PAR_HEIGHT)
  inc($n)
  set_control_par(get_ui_id($vedit), $CONTROL_PAR_POS_X, 450)
  set_control_par(get_ui_id($vedit), $CONTROL_PAR_POS_Y, 100)
  !log[$n] := "init,vedit.type," & get_control_par(get_ui_id($vedit), $CONTROL_PAR_TYPE)
  inc($n)
  !log[$n] := "init,vedit.w," & get_control_par(get_ui_id($vedit), $CONTROL_PAR_WIDTH)
  inc($n)
  !log[$n] := "init,vedit.h," & get_control_par(get_ui_id($vedit), $CONTROL_PAR_HEIGHT)
  inc($n)
  set_control_par(get_ui_id(%table), $CONTROL_PAR_POS_X, 670)
  set_control_par(get_ui_id(%table), $CONTROL_PAR_POS_Y, 100)
  !log[$n] := "init,table.type," & get_control_par(get_ui_id(%table), $CONTROL_PAR_TYPE)
  inc($n)
  !log[$n] := "init,table.w," & get_control_par(get_ui_id(%table), $CONTROL_PAR_WIDTH)
  inc($n)
  !log[$n] := "init,table.h," & get_control_par(get_ui_id(%table), $CONTROL_PAR_HEIGHT)
  inc($n)
  set_control_par(get_ui_id(?xy), $CONTROL_PAR_POS_X, 10)
  set_control_par(get_ui_id(?xy), $CONTROL_PAR_POS_Y, 190)
  !log[$n] := "init,xy.type," & get_control_par(get_ui_id(?xy), $CONTROL_PAR_TYPE)
  inc($n)
  !log[$n] := "init,xy.w," & get_control_par(get_ui_id(?xy), $CONTROL_PAR_WIDTH)
  inc($n)
  !log[$n] := "init,xy.h," & get_control_par(get_ui_id(?xy), $CONTROL_PAR_HEIGHT)
  inc($n)
  set_control_par(get_ui_id($meter), $CONTROL_PAR_POS_X, 230)
  set_control_par(get_ui_id($meter), $CONTROL_PAR_POS_Y, 190)
  !log[$n] := "init,meter.type," & get_control_par(get_ui_id($meter), $CONTROL_PAR_TYPE)
  inc($n)
  !log[$n] := "init,meter.w," & get_control_par(get_ui_id($meter), $CONTROL_PAR_WIDTH)
  inc($n)
  !log[$n] := "init,meter.h," & get_control_par(get_ui_id($meter), $CONTROL_PAR_HEIGHT)
  inc($n)
  set_control_par(get_ui_id($wave), $CONTROL_PAR_POS_X, 450)
  set_control_par(get_ui_id($wave), $CONTROL_PAR_POS_Y, 190)
  !log[$n] := "init,wave.type," & get_control_par(get_ui_id($wave), $CONTROL_PAR_TYPE)
  inc($n)
  !log[$n] := "init,wave.w," & get_control_par(get_ui_id($wave), $CONTROL_PAR_WIDTH)
