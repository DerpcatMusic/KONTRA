on ui_control ($area)
  !log[$n] := "uc,area," & $NI_MOUSE_EVENT_TYPE & "," & $NI_MOUSE_OVER_CONTROL & "," ...
    & get_control_par(get_ui_id($area), $CONTROL_PAR_KEY_SHIFT) & "," ...
    & get_control_par(get_ui_id($area), $CONTROL_PAR_KEY_ALT) & "," ...
    & get_control_par(get_ui_id($area), $CONTROL_PAR_KEY_CONTROL)
  call log_line
end on

on ui_control ($keymods)
  !log[$n] := "uc,keymods," & $keymods & "," ...
