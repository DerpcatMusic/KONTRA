function log_line
  if ($n < 1023)
    inc($n)
  end if
  pgs_set_key_val(KLOG, 0, $n)
end function

on ui_controls
  !log[$n] := "ucs," & $NI_UI_ID
  call log_line
end on

on persistence_changed
  !log[$n] := "pc"
  call log_line
end on

on pgs_changed
  save_array_str(!log, "Z:/data/dev/workspace/scratch/ksp-ui-trace/layers.nka")
end on

on ui_control ($da)
  !log[$n] := "uc,da," & $da & "," ...
    & get_control_par(get_ui_id($da), $CONTROL_PAR_KEY_SHIFT) & "," ...
    & get_control_par(get_ui_id($da), $CONTROL_PAR_KEY_ALT) & "," ...
    & get_control_par(get_ui_id($da), $CONTROL_PAR_KEY_CONTROL)
  call log_line
end on

