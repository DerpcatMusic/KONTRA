{ KSP UI probe suite, page pictures: written by tools/ksp-ui/gen.py }
on init
  make_perfview
  set_ui_width_px(900)
  set_ui_height_px(380)
  declare !log[1024]
  declare $n := 0
  pgs_create_key(KLOG, 1)
  declare ui_slider $pk0(0, 100)
  make_persistent($pk0)
  declare ui_slider $pk1(-50, 50)
  make_persistent($pk1)
  declare ui_slider $pk2(0, 1000)
  make_persistent($pk2)
  declare ui_slider $pk3(0, 10)
  make_persistent($pk3)
  declare ui_switch $psw
  make_persistent($psw)
  declare ui_button $pbt
  make_persistent($pbt)
  declare ui_label $pstate0(1, 1)
  declare ui_label $pstate1(1, 1)
  declare ui_label $pstate2(1, 1)
  declare ui_menu $pmenu
  make_persistent($pmenu)
  declare ui_value_edit $pve(0, 100, 1)
  make_persistent($pve)
  declare ui_slider $pslider(0, 100)
  make_persistent($pslider)
  declare ui_label $pframe(1, 1)
  declare ui_slider $phstrip(0, 7)
  make_persistent($phstrip)
  declare ui_knob $pknob(0, 1000, 10)
  make_persistent($pknob)
  set_control_par_str($INST_WALLPAPER_ID, $CONTROL_PAR_PICTURE, "kp_wall")
  set_control_par_str($INST_ICON_ID, $CONTROL_PAR_PICTURE, "kp_icon")
  set_skin_offset(10)
  set_control_par(get_ui_id($pk0), $CONTROL_PAR_POS_X, 20)
