  set_control_par(get_ui_id($pk0), $CONTROL_PAR_WIDTH, 40)
  set_control_par(get_ui_id($pk0), $CONTROL_PAR_HEIGHT, 40)
  set_control_par_str(get_ui_id($pk0), $CONTROL_PAR_PICTURE, "kp_knob")
  set_control_par(get_ui_id($pk0), $CONTROL_PAR_MOUSE_BEHAVIOUR, 0)
  set_control_par(get_ui_id($pk0), $CONTROL_PAR_DEFAULT_VALUE, 50)
  $pk0 := 0
  set_control_par(get_ui_id($pk1), $CONTROL_PAR_POS_X, 80)
  set_control_par(get_ui_id($pk1), $CONTROL_PAR_POS_Y, 20)
  set_control_par(get_ui_id($pk1), $CONTROL_PAR_WIDTH, 40)
  set_control_par(get_ui_id($pk1), $CONTROL_PAR_HEIGHT, 40)
  set_control_par_str(get_ui_id($pk1), $CONTROL_PAR_PICTURE, "kp_knob")
  set_control_par(get_ui_id($pk1), $CONTROL_PAR_MOUSE_BEHAVIOUR, -500)
  set_control_par(get_ui_id($pk1), $CONTROL_PAR_DEFAULT_VALUE, 0)
  $pk1 := -25
  set_control_par(get_ui_id($pk2), $CONTROL_PAR_POS_X, 140)
  set_control_par(get_ui_id($pk2), $CONTROL_PAR_POS_Y, 20)
  set_control_par(get_ui_id($pk2), $CONTROL_PAR_WIDTH, 40)
  set_control_par(get_ui_id($pk2), $CONTROL_PAR_HEIGHT, 40)
  set_control_par_str(get_ui_id($pk2), $CONTROL_PAR_PICTURE, "kp_knob")
  set_control_par(get_ui_id($pk2), $CONTROL_PAR_MOUSE_BEHAVIOUR, 1000)
  set_control_par(get_ui_id($pk2), $CONTROL_PAR_DEFAULT_VALUE, 500)
  $pk2 := 500
  set_control_par(get_ui_id($pk3), $CONTROL_PAR_POS_X, 200)
  set_control_par(get_ui_id($pk3), $CONTROL_PAR_POS_Y, 20)
  set_control_par(get_ui_id($pk3), $CONTROL_PAR_WIDTH, 40)
  set_control_par(get_ui_id($pk3), $CONTROL_PAR_HEIGHT, 40)
  set_control_par_str(get_ui_id($pk3), $CONTROL_PAR_PICTURE, "kp_knob")
  set_control_par(get_ui_id($pk3), $CONTROL_PAR_MOUSE_BEHAVIOUR, 50)
  set_control_par(get_ui_id($pk3), $CONTROL_PAR_DEFAULT_VALUE, 5)
  $pk3 := 7
  set_control_par(get_ui_id($psw), $CONTROL_PAR_POS_X, 20)
  set_control_par(get_ui_id($psw), $CONTROL_PAR_POS_Y, 90)
  set_control_par(get_ui_id($psw), $CONTROL_PAR_WIDTH, 60)
  set_control_par(get_ui_id($psw), $CONTROL_PAR_HEIGHT, 20)
  set_control_par_str(get_ui_id($psw), $CONTROL_PAR_PICTURE, "kp_switch")
  set_control_par(get_ui_id($pbt), $CONTROL_PAR_POS_X, 100)
