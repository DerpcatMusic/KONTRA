on init
  declare $cv
  declare $cb
  set_engine_par($ENGINE_PAR_VOLUME, 1000, 64, -1, -1)
  declare $r0 := 0
  declare $r1 := 0
  if ($KEY_COLOR_WARM_YELLOW = 2)
  $r0 := $r0 .or. sh_left(1, 0)
  end if
  if ($KEY_COLOR_YELLOW = 10)
  $r0 := $r0 .or. sh_left(1, 1)
  end if
  if ($KEY_COLOR_LIME = 3)
  $r0 := $r0 .or. sh_left(1, 2)
  end if
  if ($KEY_COLOR_GREEN = 11)
  $r0 := $r0 .or. sh_left(1, 3)
  end if
  if ($KEY_COLOR_MINT = 12)
  $r0 := $r0 .or. sh_left(1, 4)
  end if
  if ($KEY_COLOR_CYAN = 6)
  $r0 := $r0 .or. sh_left(1, 5)
  end if
  if ($KEY_COLOR_TURQUOISE = 13)
  $r0 := $r0 .or. sh_left(1, 6)
  end if
  if ($KEY_COLOR_BLUE = 5)
  $r0 := $r0 .or. sh_left(1, 7)
  end if
  if ($KEY_COLOR_PLUM = 14)
  $r0 := $r0 .or. sh_left(1, 8)
  end if
  if ($KEY_COLOR_VIOLET = 15)
  $r0 := $r0 .or. sh_left(1, 9)
  end if
  if ($KEY_COLOR_PURPLE = 16)
  $r0 := $r0 .or. sh_left(1, 10)
  end if
  if ($KEY_COLOR_MAGENTA = 17)
  $r0 := $r0 .or. sh_left(1, 11)
  end if
  if ($KEY_COLOR_FUCHSIA = 18)
  $r0 := $r0 .or. sh_left(1, 12)
  end if
  if ($KEY_COLOR_DEFAULT = 19)
  $r0 := $r0 .or. sh_left(1, 13)
  end if
  if ($KEY_COLOR_INACTIVE = 20)
  $r0 := $r0 .or. sh_left(1, 14)
  end if
  if ($KEY_COLOR_NONE = 0)
  $r0 := $r0 .or. sh_left(1, 15)
  end if
  if ($KEY_COLOR_WHITE = 1)
  $r0 := $r0 .or. sh_left(1, 16)
  end if
  if ($KEY_COLOR_BLACK = 7)
  $r0 := $r0 .or. sh_left(1, 17)
  end if
  if ($NI_KEY_TYPE_DEFAULT = 1)
  $r0 := $r0 .or. sh_left(1, 18)
  end if
  if ($NI_KEY_TYPE_CONTROL = 2)
  $r0 := $r0 .or. sh_left(1, 19)
  end if
  if ($NI_KEY_TYPE_NONE = 0)
  $r0 := $r0 .or. sh_left(1, 20)
  end if
  if ($NI_SYNC_UNIT_ABS = 0)
  $r0 := $r0 .or. sh_left(1, 21)
  end if
  if ($NI_SYNC_UNIT_WHOLE = 5)
  $r0 := $r0 .or. sh_left(1, 22)
  end if
  if ($NI_SYNC_UNIT_WHOLE_TRIPLET = 6)
  $r0 := $r0 .or. sh_left(1, 23)
  end if
  if ($NI_SYNC_UNIT_HALF = 7)
  $r0 := $r0 .or. sh_left(1, 24)
  end if
  if ($NI_SYNC_UNIT_HALF_TRIPLET = 8)
  $r0 := $r0 .or. sh_left(1, 25)
  end if
  if ($NI_SYNC_UNIT_QUARTER = 9)
  $r0 := $r0 .or. sh_left(1, 26)
  end if
  if ($NI_SYNC_UNIT_QUARTER_TRIPLET = 10)
  $r0 := $r0 .or. sh_left(1, 27)
  end if
  if ($NI_SYNC_UNIT_8TH = 12)
  $r0 := $r0 .or. sh_left(1, 28)
  end if
  if ($NI_SYNC_UNIT_8TH_TRIPLET = 13)
  $r0 := $r0 .or. sh_left(1, 29)
  end if
  if ($NI_SYNC_UNIT_16TH = 15)
  $r0 := $r0 .or. sh_left(1, 30)
  end if
  if ($NI_SYNC_UNIT_16TH_TRIPLET = 16)
  $r0 := $r0 .or. sh_left(1, 31)
  end if
  if ($NI_SYNC_UNIT_32ND = 17)
  $r1 := $r1 .or. sh_left(1, 0)
  end if
  if ($NI_SYNC_UNIT_32ND_TRIPLET = 18)
  $r1 := $r1 .or. sh_left(1, 1)
  end if
  if ($NI_SYNC_UNIT_64TH = 19)
  $r1 := $r1 .or. sh_left(1, 2)
  end if
  if ($NI_SYNC_UNIT_64TH_TRIPLET = 20)
  $r1 := $r1 .or. sh_left(1, 3)
  end if
  if ($NI_SYNC_UNIT_256TH = 21)
  $r1 := $r1 .or. sh_left(1, 4)
  end if
  if ($EVENT_STATUS_INACTIVE = 0)
  $r1 := $r1 .or. sh_left(1, 5)
  end if
  if ($EVENT_STATUS_NOTE_QUEUE = 1)
  $r1 := $r1 .or. sh_left(1, 6)
  end if
  if ($EVENT_STATUS_MIDI_QUEUE = 4)
  $r1 := $r1 .or. sh_left(1, 7)
  end if
  if ($HIDE_PART_NOTHING = 0)
  $r1 := $r1 .or. sh_left(1, 8)
  end if
  if ($HIDE_PART_BG = 1)
  $r1 := $r1 .or. sh_left(1, 9)
  end if
  if ($HIDE_PART_VALUE = 4)
  $r1 := $r1 .or. sh_left(1, 10)
  end if
  if ($HIDE_PART_TITLE = 2)
  $r1 := $r1 .or. sh_left(1, 11)
  end if
  if ($HIDE_PART_MOD_LIGHT = 8)
  $r1 := $r1 .or. sh_left(1, 12)
  end if
  if ($HIDE_PART_CURSOR = 32)
  $r1 := $r1 .or. sh_left(1, 13)
  end if
  if ($HIDE_WHOLE_CONTROL = 16)
  $r1 := $r1 .or. sh_left(1, 14)
  end if
  if ($NI_DND_ACCEPT_NONE = 0)
  $r1 := $r1 .or. sh_left(1, 15)
  end if
  if ($NI_DND_ACCEPT_ONE = 1)
  $r1 := $r1 .or. sh_left(1, 16)
  end if
  if ($NI_DND_ACCEPT_MULTIPLE = 512)
  $r1 := $r1 .or. sh_left(1, 17)
  end if
  if ($NI_SEND_BUS = 0)
  $r1 := $r1 .or. sh_left(1, 18)
  end if
  if ($NI_INSERT_BUS = 1)
  $r1 := $r1 .or. sh_left(1, 19)
  end if
  if ($NI_MAIN_BUS = 2)
  $r1 := $r1 .or. sh_left(1, 20)
  end if
  if ($NI_BUS_OFFSET = 1024)
  $r1 := $r1 .or. sh_left(1, 21)
  end if
  if ($NI_NOT_FOUND = -100)
  $r1 := $r1 .or. sh_left(1, 22)
  end if
  if ($GET_FOLDER_LIBRARY_DIR = 1)
  $r1 := $r1 .or. sh_left(1, 23)
  end if
  if ($GET_FOLDER_INSTALL_DIR = 0)
  $r1 := $r1 .or. sh_left(1, 24)
  end if
  if ($GET_FOLDER_PATCH_DIR = 2)
  $r1 := $r1 .or. sh_left(1, 25)
  end if
  if ($GET_FOLDER_FACTORY_DIR = 3)
  $r1 := $r1 .or. sh_left(1, 26)
  end if
  if ($GET_FOLDER_RC_DIR = 4)
  $r1 := $r1 .or. sh_left(1, 27)
  end if
  if ($UI_WAVEFORM_USE_SLICES = 1)
  $r1 := $r1 .or. sh_left(1, 28)
  end if
  if ($UI_WAVEFORM_USE_TABLE = 2)
  $r1 := $r1 .or. sh_left(1, 29)
  end if
  if ($UI_WAVEFORM_TABLE_IS_BIPOLAR = 4)
  $r1 := $r1 .or. sh_left(1, 30)
  end if
  if ($UI_WAVEFORM_USE_MIDI_DRAG = 8)
  $r1 := $r1 .or. sh_left(1, 31)
  end if
  $cv := $r0
  $cb := 0
  while ($cb < 32)
    if ((sh_right($cv, $cb) mod 2) # 0)
      set_engine_par($ENGINE_PAR_VOLUME, 1000, $cb + 0, -1, -1)
    end if
    inc($cb)
  end while
  $cv := $r1
  $cb := 0
  while ($cb < 32)
    if ((sh_right($cv, $cb) mod 2) # 0)
      set_engine_par($ENGINE_PAR_VOLUME, 1000, $cb + 32, -1, -1)
    end if
    inc($cb)
  end while
  set_engine_par($ENGINE_PAR_VOLUME, 1000, 65, -1, -1)
end on
