on init
  declare $cv
  declare $cb
  declare $i := 0
  declare $s := 0
  while ($i < 10)
  $s := $s + $i
  inc($i)
  end while
  $cv := $s
  $cb := 0
  while ($cb < 32)
    if ((sh_right($cv, $cb) mod 2) # 0)
      set_engine_par($ENGINE_PAR_VOLUME, 1000, $cb + 0, -1, -1)
    end if
    inc($cb)
  end while
  $cv := $i
  $cb := 0
  while ($cb < 32)
    if ((sh_right($cv, $cb) mod 2) # 0)
      set_engine_par($ENGINE_PAR_VOLUME, 1000, $cb + 32, -1, -1)
    end if
    inc($cb)
  end while
end on
