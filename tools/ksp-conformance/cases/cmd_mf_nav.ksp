on init
  declare $cv
  declare $cb
  set_engine_par($ENGINE_PAR_VOLUME, 1000, 64, -1, -1)
  declare $a
  declare $b
  declare $l
  declare $p
  mf_set_buffer_size(4)
  $a := mf_insert_event(0, 10, $MIDI_COMMAND_NOTE_ON, 60, 100)
  $b := mf_insert_event(0, 30, $MIDI_COMMAND_NOTE_ON, 62, 100)
  mf_get_last(0)
  $l := mf_get_id()
  mf_get_prev(0)
  $p := mf_get_id()
  $cv := $l - $b
  $cb := 0
  while ($cb < 32)
    if ((sh_right($cv, $cb) mod 2) # 0)
      set_engine_par($ENGINE_PAR_VOLUME, 1000, $cb + 0, -1, -1)
    end if
    inc($cb)
  end while
  $cv := $p - $a
  $cb := 0
  while ($cb < 32)
    if ((sh_right($cv, $cb) mod 2) # 0)
      set_engine_par($ENGINE_PAR_VOLUME, 1000, $cb + 32, -1, -1)
    end if
    inc($cb)
  end while
  set_engine_par($ENGINE_PAR_VOLUME, 1000, 65, -1, -1)
end on
