on init
  declare $cv
  declare $cb
  set_engine_par($ENGINE_PAR_VOLUME, 1000, 64, -1, -1)
  declare $r0 := 0
  declare $r1 := 0
  if ($FILTER_TYPE_BP4POLE = 10)
  $r0 := $r0 .or. sh_left(1, 0)
  end if
  if ($FILTER_TYPE_BR4POLE = 11)
  $r0 := $r0 .or. sh_left(1, 1)
  end if
  if ($FILTER_TYPE_LP6POLE = 12)
  $r0 := $r0 .or. sh_left(1, 2)
  end if
  if ($FILTER_TYPE_PHASER = 13)
  $r0 := $r0 .or. sh_left(1, 3)
  end if
  if ($FILTER_TYPE_VOWELA = 14)
  $r0 := $r0 .or. sh_left(1, 4)
  end if
  if ($FILTER_TYPE_VOWELB = 15)
  $r0 := $r0 .or. sh_left(1, 5)
  end if
  if ($FILTER_TYPE_PRO52 = 16)
  $r0 := $r0 .or. sh_left(1, 6)
  end if
  if ($FILTER_TYPE_LADDER = 17)
  $r0 := $r0 .or. sh_left(1, 7)
  end if
  if ($FILTER_TYPE_VERSATILE = 19)
  $r0 := $r0 .or. sh_left(1, 8)
  end if
  if ($FILTER_TYPE_EQ1BAND = 22)
  $r0 := $r0 .or. sh_left(1, 9)
  end if
  if ($FILTER_TYPE_EQ2BAND = 23)
  $r0 := $r0 .or. sh_left(1, 10)
  end if
  if ($FILTER_TYPE_EQ3BAND = 24)
  $r0 := $r0 .or. sh_left(1, 11)
  end if
  if ($FILTER_TYPE_LDR_LP1 = 30)
  $r0 := $r0 .or. sh_left(1, 12)
  end if
  if ($FILTER_TYPE_LDR_LP2 = 31)
  $r0 := $r0 .or. sh_left(1, 13)
  end if
  if ($FILTER_TYPE_LDR_LP3 = 32)
  $r0 := $r0 .or. sh_left(1, 14)
  end if
  if ($FILTER_TYPE_LDR_LP4 = 33)
  $r0 := $r0 .or. sh_left(1, 15)
  end if
  if ($FILTER_TYPE_LDR_HP1 = 34)
  $r0 := $r0 .or. sh_left(1, 16)
  end if
  if ($FILTER_TYPE_LDR_HP2 = 35)
  $r0 := $r0 .or. sh_left(1, 17)
  end if
  if ($FILTER_TYPE_LDR_HP3 = 36)
  $r0 := $r0 .or. sh_left(1, 18)
  end if
  if ($FILTER_TYPE_LDR_HP4 = 37)
  $r0 := $r0 .or. sh_left(1, 19)
  end if
  if ($FILTER_TYPE_LDR_BP2 = 38)
  $r0 := $r0 .or. sh_left(1, 20)
  end if
  if ($FILTER_TYPE_LDR_BP4 = 39)
  $r0 := $r0 .or. sh_left(1, 21)
  end if
  if ($FILTER_TYPE_LDR_PEAK = 40)
  $r0 := $r0 .or. sh_left(1, 22)
  end if
  if ($FILTER_TYPE_LDR_NOTCH = 41)
  $r0 := $r0 .or. sh_left(1, 23)
  end if
  if ($FILTER_TYPE_SV_LP1 = 50)
  $r0 := $r0 .or. sh_left(1, 24)
  end if
  if ($FILTER_TYPE_SV_HP1 = 51)
  $r0 := $r0 .or. sh_left(1, 25)
  end if
  if ($FILTER_TYPE_SV_LP2 = 52)
  $r0 := $r0 .or. sh_left(1, 26)
  end if
  if ($FILTER_TYPE_SV_BP2 = 53)
  $r0 := $r0 .or. sh_left(1, 27)
  end if
  if ($FILTER_TYPE_SV_HP2 = 54)
  $r0 := $r0 .or. sh_left(1, 28)
  end if
  if ($FILTER_TYPE_SV_LP4 = 55)
  $r0 := $r0 .or. sh_left(1, 29)
  end if
  if ($FILTER_TYPE_SV_BP4 = 56)
  $r0 := $r0 .or. sh_left(1, 30)
  end if
  if ($FILTER_TYPE_SV_HP4 = 57)
  $r0 := $r0 .or. sh_left(1, 31)
  end if
  if ($FILTER_TYPE_SV_NOTCH4 = 58)
  $r1 := $r1 .or. sh_left(1, 0)
  end if
  if ($FILTER_TYPE_SV_LP6 = 59)
  $r1 := $r1 .or. sh_left(1, 1)
  end if
  if ($FILTER_TYPE_SV_BP6 = 60)
  $r1 := $r1 .or. sh_left(1, 2)
  end if
  if ($FILTER_TYPE_SV_HP6 = 61)
  $r1 := $r1 .or. sh_left(1, 3)
  end if
  if ($FILTER_TYPE_SV_NOTCH6 = 62)
  $r1 := $r1 .or. sh_left(1, 4)
  end if
  if ($FILTER_TYPE_SV_PAR_LPHP = 63)
  $r1 := $r1 .or. sh_left(1, 5)
  end if
  if ($FILTER_TYPE_SV_PAR_BPBP = 64)
  $r1 := $r1 .or. sh_left(1, 6)
  end if
  if ($FILTER_TYPE_SV_SER_LPHP = 65)
  $r1 := $r1 .or. sh_left(1, 7)
  end if
  if ($FILTER_TYPE_DAFT_LP = 70)
  $r1 := $r1 .or. sh_left(1, 8)
  end if
  if ($FILTER_TYPE_DAFT_HP = 71)
  $r1 := $r1 .or. sh_left(1, 9)
  end if
  if ($FILTER_TYPE_FORMANT_1 = 90)
  $r1 := $r1 .or. sh_left(1, 10)
  end if
  if ($FILTER_TYPE_FORMANT_2 = 91)
  $r1 := $r1 .or. sh_left(1, 11)
  end if
  if ($FILTER_TYPE_AR_LP2 = 100)
  $r1 := $r1 .or. sh_left(1, 12)
  end if
  if ($FILTER_TYPE_AR_BP2 = 101)
  $r1 := $r1 .or. sh_left(1, 13)
  end if
  if ($FILTER_TYPE_AR_HP2 = 102)
  $r1 := $r1 .or. sh_left(1, 14)
  end if
  if ($FILTER_TYPE_AR_LP4 = 103)
  $r1 := $r1 .or. sh_left(1, 15)
  end if
  if ($FILTER_TYPE_AR_BP4 = 104)
  $r1 := $r1 .or. sh_left(1, 16)
  end if
  if ($FILTER_TYPE_AR_HP4 = 105)
  $r1 := $r1 .or. sh_left(1, 17)
  end if
  if ($FILTER_TYPE_AR_LP24 = 106)
  $r1 := $r1 .or. sh_left(1, 18)
  end if
  if ($FILTER_TYPE_AR_BP24 = 107)
  $r1 := $r1 .or. sh_left(1, 19)
  end if
  if ($FILTER_TYPE_AR_HP24 = 108)
  $r1 := $r1 .or. sh_left(1, 20)
  end if
  if ($FILTER_TYPE_SIMPLE_LPHP = 120)
  $r1 := $r1 .or. sh_left(1, 21)
  end if
  if ($FILTER_TYPE_DUAL_SKF = 130)
  $r1 := $r1 .or. sh_left(1, 22)
  end if
  if ($FILTER_TYPE_MONARK_LP1 = 140)
  $r1 := $r1 .or. sh_left(1, 23)
  end if
  if ($FILTER_TYPE_MONARK_LP2 = 141)
  $r1 := $r1 .or. sh_left(1, 24)
  end if
  if ($FILTER_TYPE_MONARK_LP4 = 142)
  $r1 := $r1 .or. sh_left(1, 25)
  end if
  if ($FILTER_TYPE_MONARK_BP = 143)
  $r1 := $r1 .or. sh_left(1, 26)
  end if
  if ($MIDI_COMMAND_NOTE_ON = 144)
  $r1 := $r1 .or. sh_left(1, 27)
  end if
  if ($MIDI_COMMAND_NOTE_OFF = 128)
  $r1 := $r1 .or. sh_left(1, 28)
  end if
  if ($MIDI_COMMAND_POLY_AT = 160)
  $r1 := $r1 .or. sh_left(1, 29)
  end if
  if ($MIDI_COMMAND_CC = 176)
  $r1 := $r1 .or. sh_left(1, 30)
  end if
  if ($MIDI_COMMAND_PROGRAM_CHANGE = 192)
  $r1 := $r1 .or. sh_left(1, 31)
  end if
  $cv := $r0
  $cb := 0
  while ($cb < 32)
    if ((sh_right($cv, $cb) mod 2) # 0)
      set_engine_par($ENGINE_PAR_VOLUME, 1000, $cb + 0, -1, -1)
    end if
    inc($cb)
  end while
  $cv := $r1
  $cb := 0
  while ($cb < 32)
    if ((sh_right($cv, $cb) mod 2) # 0)
      set_engine_par($ENGINE_PAR_VOLUME, 1000, $cb + 32, -1, -1)
    end if
    inc($cb)
  end while
  set_engine_par($ENGINE_PAR_VOLUME, 1000, 65, -1, -1)
end on
