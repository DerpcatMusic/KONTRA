on init
  declare $cv
  declare $cb
  set_engine_par($ENGINE_PAR_VOLUME, 1000, 64, -1, -1)
  declare $r0 := 0
  declare $r1 := 0
  if ($LFO_TYPE_TRIANGLE = 2)
  $r0 := $r0 .or. sh_left(1, 0)
  end if
  if ($MOD_TARGET_INVERT_SOURCE = 315)
  $r0 := $r0 .or. sh_left(1, 1)
  end if
  if ($NI_BEATMASHER_LENGTH_16TH = 7)
  $r0 := $r0 .or. sh_left(1, 2)
  end if
  if ($NI_BEATMASHER_LENGTH_32ND = 8)
  $r0 := $r0 .or. sh_left(1, 3)
  end if
  if ($NI_BEATMASHER_LENGTH_8TH = 6)
  $r0 := $r0 .or. sh_left(1, 4)
  end if
  if ($NI_BEATMASHER_LENGTH_8TH_DOTTED = 5)
  $r0 := $r0 .or. sh_left(1, 5)
  end if
  if ($NI_BITE_HPF_MODE_100 = 1)
  $r0 := $r0 .or. sh_left(1, 6)
  end if
  if ($NI_BITE_HPF_MODE_200 = 2)
  $r0 := $r0 .or. sh_left(1, 7)
  end if
  if ($NI_BITE_HPF_MODE_5 = 0)
  $r0 := $r0 .or. sh_left(1, 8)
  end if
  if ($NI_EPP_EQ_MODE_70S = 2)
  $r0 := $r0 .or. sh_left(1, 9)
  end if
  if ($NI_EPP_EQ_MODE_80S = 3)
  $r0 := $r0 .or. sh_left(1, 10)
  end if
  if ($NI_EPP_TREMOLO_MODE_70S = 1)
  $r0 := $r0 .or. sh_left(1, 11)
  end if
  if ($NI_EPP_TREMOLO_MODE_80S = 2)
  $r0 := $r0 .or. sh_left(1, 12)
  end if
  if ($NI_S1200_FILTER_HIGH = 5)
  $r0 := $r0 .or. sh_left(1, 13)
  end if
  if ($NI_S1200_FILTER_HIGH_MID = 4)
  $r0 := $r0 .or. sh_left(1, 14)
  end if
  if ($NI_S1200_FILTER_LOW = 2)
  $r0 := $r0 .or. sh_left(1, 15)
  end if
  if ($NI_S1200_FILTER_LOW_MID = 3)
  $r0 := $r0 .or. sh_left(1, 16)
  end if
  if ($NI_S1200_FILTER_NONE = 1)
  $r0 := $r0 .or. sh_left(1, 17)
  end if
  if ($NI_SOURCE_MODE_MP60_MACHINE = 8)
  $r0 := $r0 .or. sh_left(1, 18)
  end if
  if ($NI_SOURCE_MODE_S1200_MACHINE = 7)
  $r0 := $r0 .or. sh_left(1, 19)
  end if
  if ($NI_SOURCE_MODE_TIME_MACHINE_1 = 3)
  $r0 := $r0 .or. sh_left(1, 20)
  end if
  if ($NI_SOURCE_MODE_TIME_MACHINE_2 = 6)
  $r0 := $r0 .or. sh_left(1, 21)
  end if
  if ($NI_SUPERGT_HPF_MODE_100 = 1)
  $r0 := $r0 .or. sh_left(1, 22)
  end if
  if ($NI_SUPERGT_HPF_MODE_300 = 2)
  $r0 := $r0 .or. sh_left(1, 23)
  end if
  if ($NI_VC_DEPTH_1 = 0)
  $r0 := $r0 .or. sh_left(1, 24)
  end if
  if ($NI_VC_DEPTH_2 = 1)
  $r0 := $r0 .or. sh_left(1, 25)
  end if
  if ($NI_VC_DEPTH_3 = 2)
  $r0 := $r0 .or. sh_left(1, 26)
  end if
  if ($NI_VC_DEPTH_4 = 3)
  $r0 := $r0 .or. sh_left(1, 27)
  end if
  if ($NI_VC_DEPTH_5 = 4)
  $r0 := $r0 .or. sh_left(1, 28)
  end if
  if ($NI_VC_DEPTH_6 = 5)
  $r0 := $r0 .or. sh_left(1, 29)
  end if
  if ($NI_WF_VIS_MODE_1 = 0)
  $r0 := $r0 .or. sh_left(1, 30)
  end if
  if ($NI_WF_VIS_MODE_2 = 1)
  $r0 := $r0 .or. sh_left(1, 31)
  end if
  if ($NI_WF_VIS_MODE_3 = 2)
  $r1 := $r1 .or. sh_left(1, 0)
  end if
  if ($NI_WT_MOD_WAVE_TX2 = 2)
  $r1 := $r1 .or. sh_left(1, 1)
  end if
  if ($NI_WT_MOD_WAVE_TX3 = 3)
  $r1 := $r1 .or. sh_left(1, 2)
  end if
  if ($NI_WT_MOD_WAVE_TX4 = 4)
  $r1 := $r1 .or. sh_left(1, 3)
  end if
  if ($NI_WT_MOD_WAVE_TX5 = 5)
  $r1 := $r1 .or. sh_left(1, 4)
  end if
  if ($NI_WT_MOD_WAVE_TX6 = 6)
  $r1 := $r1 .or. sh_left(1, 5)
  end if
  if ($NI_WT_MOD_WAVE_TX7 = 7)
  $r1 := $r1 .or. sh_left(1, 6)
  end if
  if ($NI_WT_MOD_WAVE_TX8 = 8)
  $r1 := $r1 .or. sh_left(1, 7)
  end if
  if ($NI_WT_VIS_2D = 1)
  $r1 := $r1 .or. sh_left(1, 8)
  end if
  if ($NI_WT_VIS_3D = 2)
  $r1 := $r1 .or. sh_left(1, 9)
  end if
  if ($START_CRITERIA_AND_NEXT = 0)
  $r1 := $r1 .or. sh_left(1, 10)
  end if
  if ($START_CRITERIA_AND_NOT_NEXT = 1)
  $r1 := $r1 .or. sh_left(1, 11)
  end if
  if ($START_CRITERIA_CYCLE_RANDOM = 4)
  $r1 := $r1 .or. sh_left(1, 12)
  end if
  if ($START_CRITERIA_CYCLE_ROUND_ROBIN = 3)
  $r1 := $r1 .or. sh_left(1, 13)
  end if
  if ($START_CRITERIA_NONE = 0)
  $r1 := $r1 .or. sh_left(1, 14)
  end if
  if ($START_CRITERIA_ON_CONTROLLER = 2)
  $r1 := $r1 .or. sh_left(1, 15)
  end if
  if ($START_CRITERIA_ON_KEY = 1)
  $r1 := $r1 .or. sh_left(1, 16)
  end if
  if ($START_CRITERIA_OR_NEXT = 2)
  $r1 := $r1 .or. sh_left(1, 17)
  end if
  if ($START_CRITERIA_SLICE_TRIGGER = 5)
  $r1 := $r1 .or. sh_left(1, 18)
  end if
  if ($UI_WF_PROP_FLAGS = 2)
  $r1 := $r1 .or. sh_left(1, 19)
  end if
  if ($UI_WF_PROP_PLAY_CURSOR = 1)
  $r1 := $r1 .or. sh_left(1, 20)
  end if
  if ($UI_WF_PROP_TABLE_VAL = 3)
  $r1 := $r1 .or. sh_left(1, 21)
  end if
  if ($REF_GROUP_IDX = 0)
  $r1 := $r1 .or. sh_left(1, 22)
  end if
  $cv := $r0
  $cb := 0
  while ($cb < 32)
    if ((sh_right($cv, $cb) mod 2) # 0)
      set_engine_par($ENGINE_PAR_VOLUME, 1000, $cb + 0, -1, -1)
    end if
    inc($cb)
  end while
  $cv := $r1
  $cb := 0
  while ($cb < 32)
    if ((sh_right($cv, $cb) mod 2) # 0)
      set_engine_par($ENGINE_PAR_VOLUME, 1000, $cb + 32, -1, -1)
    end if
    inc($cb)
  end while
  set_engine_par($ENGINE_PAR_VOLUME, 1000, 65, -1, -1)
end on
