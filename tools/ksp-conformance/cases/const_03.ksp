on init
  declare $cv
  declare $cb
  set_engine_par($ENGINE_PAR_VOLUME, 1000, 64, -1, -1)
  declare $r0 := 0
  declare $r1 := 0
  if ($NI_FLAIR_SCANMODE_SAW_UP = 1)
  $r0 := $r0 .or. sh_left(1, 0)
  end if
  if ($NI_FLAIR_SCANMODE_SAW_DOWN = 2)
  $r0 := $r0 .or. sh_left(1, 1)
  end if
  if ($EFFECT_TYPE_FREAK = 54)
  $r0 := $r0 .or. sh_left(1, 2)
  end if
  if ($EFFECT_TYPE_CHORAL = 43)
  $r0 := $r0 .or. sh_left(1, 3)
  end if
  if ($NI_CHORAL_MODE_SYNTH = 0)
  $r0 := $r0 .or. sh_left(1, 4)
  end if
  if ($NI_CHORAL_MODE_ENSEMBLE = 1)
  $r0 := $r0 .or. sh_left(1, 5)
  end if
  if ($NI_CHORAL_MODE_DIMENSION = 2)
  $r0 := $r0 .or. sh_left(1, 6)
  end if
  if ($NI_CHORAL_MODE_UNIVERSAL = 3)
  $r0 := $r0 .or. sh_left(1, 7)
  end if
  if ($EFFECT_TYPE_BASSINVADER = 48)
  $r0 := $r0 .or. sh_left(1, 8)
  end if
  if ($EFFECT_TYPE_TRANSLIM = 45)
  $r0 := $r0 .or. sh_left(1, 9)
  end if
  if ($EFFECT_TYPE_SUPERGT = 46)
  $r0 := $r0 .or. sh_left(1, 10)
  end if
  if ($EFFECT_TYPE_REVERB = 17)
  $r0 := $r0 .or. sh_left(1, 11)
  end if
  if ($EFFECT_TYPE_DELAY = 18)
  $r0 := $r0 .or. sh_left(1, 12)
  end if
  if ($EFFECT_TYPE_PSYCHEDELAY = 49)
  $r0 := $r0 .or. sh_left(1, 13)
  end if
  if ($EFFECT_TYPE_REPLIKA = 40)
  $r0 := $r0 .or. sh_left(1, 14)
  end if
  if ($EFFECT_TYPE_TWINDELAY = 57)
  $r0 := $r0 .or. sh_left(1, 15)
  end if
  if ($EFFECT_TYPE_IRC = 19)
  $r0 := $r0 .or. sh_left(1, 16)
  end if
  if ($EFFECT_TYPE_SKREAMER = 21)
  $r0 := $r0 .or. sh_left(1, 17)
  end if
  if ($EFFECT_TYPE_SOLID_GEQ = 28)
  $r0 := $r0 .or. sh_left(1, 18)
  end if
  if ($EFFECT_TYPE_ROTATOR = 22)
  $r0 := $r0 .or. sh_left(1, 19)
  end if
  if ($EFFECT_TYPE_RINGMOD = 50)
  $r0 := $r0 .or. sh_left(1, 20)
  end if
  if ($EFFECT_TYPE_TWANG = 23)
  $r0 := $r0 .or. sh_left(1, 21)
  end if
  if ($EFFECT_TYPE_CABINET = 24)
  $r0 := $r0 .or. sh_left(1, 22)
  end if
  if ($EFFECT_TYPE_AET_FILTER = 25)
  $r0 := $r0 .or. sh_left(1, 23)
  end if
  if ($EFFECT_TYPE_TRANS_MASTER = 27)
  $r0 := $r0 .or. sh_left(1, 24)
  end if
  if ($EFFECT_TYPE_FB_COMP = 30)
  $r0 := $r0 .or. sh_left(1, 25)
  end if
  if ($EFFECT_TYPE_JUMP = 31)
  $r0 := $r0 .or. sh_left(1, 26)
  end if
  if ($EFFECT_TYPE_VAN51 = 32)
  $r0 := $r0 .or. sh_left(1, 27)
  end if
  if ($EFFECT_TYPE_ACBOX = 33)
  $r0 := $r0 .or. sh_left(1, 28)
  end if
  if ($EFFECT_TYPE_HOTSOLO = 34)
  $r0 := $r0 .or. sh_left(1, 29)
  end if
  if ($EFFECT_TYPE_BASSPRO = 47)
  $r0 := $r0 .or. sh_left(1, 30)
  end if
  if ($EFFECT_TYPE_BITE = 52)
  $r0 := $r0 .or. sh_left(1, 31)
  end if
  if ($EFFECT_TYPE_CAT = 35)
  $r1 := $r1 .or. sh_left(1, 0)
  end if
  if ($EFFECT_TYPE_DIRT = 53)
  $r1 := $r1 .or. sh_left(1, 1)
  end if
  if ($EFFECT_TYPE_DSTORTION = 36)
  $r1 := $r1 .or. sh_left(1, 2)
  end if
  if ($EFFECT_TYPE_CRYWAH = 37)
  $r1 := $r1 .or. sh_left(1, 3)
  end if
  if ($EFFECT_TYPE_BUS_COMP = 29)
  $r1 := $r1 .or. sh_left(1, 4)
  end if
  if ($EFFECT_TYPE_TAPE_SAT = 26)
  $r1 := $r1 .or. sh_left(1, 5)
  end if
  if ($EFFECT_TYPE_WOWFLUTTER = 56)
  $r1 := $r1 .or. sh_left(1, 6)
  end if
  if ($EFFECT_TYPE_REVERB2 = 39)
  $r1 := $r1 .or. sh_left(1, 7)
  end if
  if ($EFFECT_TYPE_PLATEREVERB = 38)
  $r1 := $r1 .or. sh_left(1, 8)
  end if
  if ($EFFECT_TYPE_RAUM = 51)
  $r1 := $r1 .or. sh_left(1, 9)
  end if
  if ($EFFECT_TYPE_VIBRATO_CHORUS = 55)
  $r1 := $r1 .or. sh_left(1, 10)
  end if
  if ($EFFECT_TYPE_EP_PREAMPS = 58)
  $r1 := $r1 .or. sh_left(1, 11)
  end if
  if ($EFFECT_TYPE_FUZZ = 59)
  $r1 := $r1 .or. sh_left(1, 12)
  end if
  if ($EFFECT_TYPE_BIGFUZZ = 60)
  $r1 := $r1 .or. sh_left(1, 13)
  end if
  if ($EFFECT_TYPE_STEREO_TUNE = 61)
  $r1 := $r1 .or. sh_left(1, 14)
  end if
  if ($EFFECT_TYPE_BEATMASHER = 62)
  $r1 := $r1 .or. sh_left(1, 15)
  end if
  if ($EFFECT_TYPE_BEATSLICER = 64)
  $r1 := $r1 .or. sh_left(1, 16)
  end if
  if ($EFFECT_TYPE_GATER = 63)
  $r1 := $r1 .or. sh_left(1, 17)
  end if
  if ($EFFECT_TYPE_REVGRAIN = 65)
  $r1 := $r1 .or. sh_left(1, 18)
  end if
  if ($EFFECT_TYPE_TRANS_STRETCH = 66)
  $r1 := $r1 .or. sh_left(1, 19)
  end if
  if ($EFFECT_TYPE_SUPERFAST100 = 67)
  $r1 := $r1 .or. sh_left(1, 20)
  end if
  if ($EFFECT_TYPE_CHAINSAW = 68)
  $r1 := $r1 .or. sh_left(1, 21)
  end if
  if ($EFFECT_TYPE_SKREAMERDLX = 69)
  $r1 := $r1 .or. sh_left(1, 22)
  end if
  if ($EFFECT_TYPE_KOLOR = 70)
  $r1 := $r1 .or. sh_left(1, 23)
  end if
  if ($EFFECT_TYPE_REVERBDELIGHT = 71)
  $r1 := $r1 .or. sh_left(1, 24)
  end if
  if ($FILTER_TYPE_LP1POLE = 2)
  $r1 := $r1 .or. sh_left(1, 25)
  end if
  if ($FILTER_TYPE_HP1POLE = 3)
  $r1 := $r1 .or. sh_left(1, 26)
  end if
  if ($FILTER_TYPE_BP2POLE = 4)
  $r1 := $r1 .or. sh_left(1, 27)
  end if
  if ($FILTER_TYPE_LP2POLE = 6)
  $r1 := $r1 .or. sh_left(1, 28)
  end if
  if ($FILTER_TYPE_HP2POLE = 7)
  $r1 := $r1 .or. sh_left(1, 29)
  end if
  if ($FILTER_TYPE_LP4POLE = 8)
  $r1 := $r1 .or. sh_left(1, 30)
  end if
  if ($FILTER_TYPE_HP4POLE = 9)
  $r1 := $r1 .or. sh_left(1, 31)
  end if
  $cv := $r0
  $cb := 0
  while ($cb < 32)
    if ((sh_right($cv, $cb) mod 2) # 0)
      set_engine_par($ENGINE_PAR_VOLUME, 1000, $cb + 0, -1, -1)
    end if
    inc($cb)
  end while
  $cv := $r1
  $cb := 0
  while ($cb < 32)
    if ((sh_right($cv, $cb) mod 2) # 0)
      set_engine_par($ENGINE_PAR_VOLUME, 1000, $cb + 32, -1, -1)
    end if
    inc($cb)
  end while
  set_engine_par($ENGINE_PAR_VOLUME, 1000, 65, -1, -1)
end on
