on init
  declare $cv
  declare $cb
  set_engine_par($ENGINE_PAR_VOLUME, 1000, 64, -1, -1)
  declare $r0 := 0
  declare $r1 := 0
  if ($MIDI_COMMAND_MONO_AT = 208)
  $r0 := $r0 .or. sh_left(1, 0)
  end if
  if ($MIDI_COMMAND_PITCH_BEND = 224)
  $r0 := $r0 .or. sh_left(1, 1)
  end if
  if ($NI_CONTROL_TYPE_NONE = 0)
  $r0 := $r0 .or. sh_left(1, 2)
  end if
  if ($NI_CONTROL_TYPE_BUTTON = 1)
  $r0 := $r0 .or. sh_left(1, 3)
  end if
  if ($NI_CONTROL_TYPE_KNOB = 2)
  $r0 := $r0 .or. sh_left(1, 4)
  end if
  if ($NI_CONTROL_TYPE_MENU = 3)
  $r0 := $r0 .or. sh_left(1, 5)
  end if
  if ($NI_CONTROL_TYPE_VALUE_EDIT = 4)
  $r0 := $r0 .or. sh_left(1, 6)
  end if
  if ($NI_CONTROL_TYPE_LABEL = 5)
  $r0 := $r0 .or. sh_left(1, 7)
  end if
  if ($NI_CONTROL_TYPE_TABLE = 6)
  $r0 := $r0 .or. sh_left(1, 8)
  end if
  if ($NI_CONTROL_TYPE_WAVEFORM = 7)
  $r0 := $r0 .or. sh_left(1, 9)
  end if
  if ($NI_CONTROL_TYPE_WAVETABLE = 8)
  $r0 := $r0 .or. sh_left(1, 10)
  end if
  if ($NI_CONTROL_TYPE_SLIDER = 9)
  $r0 := $r0 .or. sh_left(1, 11)
  end if
  if ($NI_CONTROL_TYPE_TEXT_EDIT = 10)
  $r0 := $r0 .or. sh_left(1, 12)
  end if
  if ($NI_CONTROL_TYPE_FILE_SELECTOR = 11)
  $r0 := $r0 .or. sh_left(1, 13)
  end if
  if ($NI_CONTROL_TYPE_SWITCH = 12)
  $r0 := $r0 .or. sh_left(1, 14)
  end if
  if ($NI_CONTROL_TYPE_XY = 13)
  $r0 := $r0 .or. sh_left(1, 15)
  end if
  if ($NI_CONTROL_TYPE_LEVEL_METER = 14)
  $r0 := $r0 .or. sh_left(1, 16)
  end if
  if ($NI_CONTROL_TYPE_MOUSE_AREA = 15)
  $r0 := $r0 .or. sh_left(1, 17)
  end if
  if ($NI_CONTROL_TYPE_PANEL = 16)
  $r0 := $r0 .or. sh_left(1, 18)
  end if
  if ($MARK_1 = 2)
  $r0 := $r0 .or. sh_left(1, 19)
  end if
  if ($MARK_2 = 4)
  $r0 := $r0 .or. sh_left(1, 20)
  end if
  if ($MARK_3 = 8)
  $r0 := $r0 .or. sh_left(1, 21)
  end if
  if ($MARK_4 = 16)
  $r0 := $r0 .or. sh_left(1, 22)
  end if
  if ($MARK_5 = 32)
  $r0 := $r0 .or. sh_left(1, 23)
  end if
  if ($MARK_6 = 64)
  $r0 := $r0 .or. sh_left(1, 24)
  end if
  if ($MARK_7 = 128)
  $r0 := $r0 .or. sh_left(1, 25)
  end if
  if ($MARK_8 = 256)
  $r0 := $r0 .or. sh_left(1, 26)
  end if
  if ($MARK_9 = 512)
  $r0 := $r0 .or. sh_left(1, 27)
  end if
  if ($MARK_10 = 1024)
  $r0 := $r0 .or. sh_left(1, 28)
  end if
  if ($MARK_11 = 2048)
  $r0 := $r0 .or. sh_left(1, 29)
  end if
  if ($MARK_12 = 4096)
  $r0 := $r0 .or. sh_left(1, 30)
  end if
  if ($MARK_13 = 8192)
  $r0 := $r0 .or. sh_left(1, 31)
  end if
  if ($MARK_14 = 16384)
  $r1 := $r1 .or. sh_left(1, 0)
  end if
  if ($MARK_15 = 32768)
  $r1 := $r1 .or. sh_left(1, 1)
  end if
  if ($MARK_16 = 65536)
  $r1 := $r1 .or. sh_left(1, 2)
  end if
  if ($MARK_17 = 131072)
  $r1 := $r1 .or. sh_left(1, 3)
  end if
  if ($MARK_18 = 262144)
  $r1 := $r1 .or. sh_left(1, 4)
  end if
  if ($MARK_19 = 524288)
  $r1 := $r1 .or. sh_left(1, 5)
  end if
  if ($MARK_20 = 1048576)
  $r1 := $r1 .or. sh_left(1, 6)
  end if
  if ($MARK_21 = 2097152)
  $r1 := $r1 .or. sh_left(1, 7)
  end if
  if ($MARK_22 = 4194304)
  $r1 := $r1 .or. sh_left(1, 8)
  end if
  if ($MARK_23 = 8388608)
  $r1 := $r1 .or. sh_left(1, 9)
  end if
  if ($MARK_24 = 16777216)
  $r1 := $r1 .or. sh_left(1, 10)
  end if
  if ($MARK_25 = 33554432)
  $r1 := $r1 .or. sh_left(1, 11)
  end if
  if ($MARK_26 = 67108864)
  $r1 := $r1 .or. sh_left(1, 12)
  end if
  if ($MARK_27 = 134217728)
  $r1 := $r1 .or. sh_left(1, 13)
  end if
  if ($MARK_28 = 268435456)
  $r1 := $r1 .or. sh_left(1, 14)
  end if
  if ($EVENT_PAR_0 = 0)
  $r1 := $r1 .or. sh_left(1, 15)
  end if
  if ($EVENT_PAR_1 = 1)
  $r1 := $r1 .or. sh_left(1, 16)
  end if
  if ($EVENT_PAR_2 = 2)
  $r1 := $r1 .or. sh_left(1, 17)
  end if
  if ($EVENT_PAR_3 = 3)
  $r1 := $r1 .or. sh_left(1, 18)
  end if
  if ($CURRENT_EVENT = 0)
  $r1 := $r1 .or. sh_left(1, 19)
  end if
  if ($EVENT_PAR_MIDI_COMMAND = 12)
  $r1 := $r1 .or. sh_left(1, 20)
  end if
  if ($EVENT_PAR_MIDI_BYTE_1 = 13)
  $r1 := $r1 .or. sh_left(1, 21)
  end if
  if ($EVENT_PAR_MIDI_BYTE_2 = 14)
  $r1 := $r1 .or. sh_left(1, 22)
  end if
  if ($EVENT_PAR_POS = 21)
  $r1 := $r1 .or. sh_left(1, 23)
  end if
  if ($EVENT_PAR_NOTE_LENGTH = 24)
  $r1 := $r1 .or. sh_left(1, 24)
  end if
  if ($EVENT_PAR_ID = 25)
  $r1 := $r1 .or. sh_left(1, 25)
  end if
  if ($EVENT_PAR_TRACK_NR = 22)
  $r1 := $r1 .or. sh_left(1, 26)
  end if
  if ($NI_REVERB2_TYPE_ROOM = 0)
  $r1 := $r1 .or. sh_left(1, 27)
  end if
  if ($NI_REVERB2_TYPE_HALL = 1)
  $r1 := $r1 .or. sh_left(1, 28)
  end if
  if ($VALUE_EDIT_MODE_NOTE_NAMES = 0)
  $r1 := $r1 .or. sh_left(1, 29)
  end if
  if ($NI_FADE_LINEAR = 0)
  $r1 := $r1 .or. sh_left(1, 30)
  end if
  if ($NI_FADE_EQUAL_POWER = 1)
  $r1 := $r1 .or. sh_left(1, 31)
  end if
  $cv := $r0
  $cb := 0
  while ($cb < 32)
    if ((sh_right($cv, $cb) mod 2) # 0)
      set_engine_par($ENGINE_PAR_VOLUME, 1000, $cb + 0, -1, -1)
    end if
    inc($cb)
  end while
  $cv := $r1
  $cb := 0
  while ($cb < 32)
    if ((sh_right($cv, $cb) mod 2) # 0)
      set_engine_par($ENGINE_PAR_VOLUME, 1000, $cb + 32, -1, -1)
    end if
    inc($cb)
  end while
  set_engine_par($ENGINE_PAR_VOLUME, 1000, 65, -1, -1)
end on
