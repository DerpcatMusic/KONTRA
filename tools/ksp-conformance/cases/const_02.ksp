on init
  declare $cv
  declare $cb
  set_engine_par($ENGINE_PAR_VOLUME, 1000, 64, -1, -1)
  declare $r0 := 0
  declare $r1 := 0
  if ($NI_KONTAKT_IS_HEADLESS = 0)
  $r0 := $r0 .or. sh_left(1, 0)
  end if
  if ($NI_KONTAKT_IS_STANDALONE = 1)
  $r0 := $r0 .or. sh_left(1, 1)
  end if
  if ($ALL_GROUPS = -1)
  $r0 := $r0 .or. sh_left(1, 2)
  end if
  if ($ALL_EVENTS = -1)
  $r0 := $r0 .or. sh_left(1, 3)
  end if
  if ($VCC_PITCH_BEND = 128)
  $r0 := $r0 .or. sh_left(1, 4)
  end if
  if ($VCC_MONO_AT = 129)
  $r0 := $r0 .or. sh_left(1, 5)
  end if
  if ($INST_ICON_ID = 16385)
  $r0 := $r0 .or. sh_left(1, 6)
  end if
  if ($INST_WALLPAPER_ID = 16386)
  $r0 := $r0 .or. sh_left(1, 7)
  end if
  if ($INST_LIB_COPYRIGHT_ID = 16387)
  $r0 := $r0 .or. sh_left(1, 8)
  end if
  if ($INST_LIB_DESCRIPTION_ID = 16388)
  $r0 := $r0 .or. sh_left(1, 9)
  end if
  if ($INST_LIB_PIC_ONE_ID = 16389)
  $r0 := $r0 .or. sh_left(1, 10)
  end if
  if ($INST_LIB_PIC_TWO_ID = 16390)
  $r0 := $r0 .or. sh_left(1, 11)
  end if
  if ($EVENT_PAR_VOLUME = 4)
  $r0 := $r0 .or. sh_left(1, 12)
  end if
  if ($EVENT_PAR_TUNE = 6)
  $r0 := $r0 .or. sh_left(1, 13)
  end if
  if ($EVENT_PAR_PAN = 5)
  $r0 := $r0 .or. sh_left(1, 14)
  end if
  if ($EVENT_PAR_NOTE = 7)
  $r0 := $r0 .or. sh_left(1, 15)
  end if
  if ($EVENT_PAR_VELOCITY = 9)
  $r0 := $r0 .or. sh_left(1, 16)
  end if
  if ($EVENT_PAR_ALLOW_GROUP = 10)
  $r0 := $r0 .or. sh_left(1, 17)
  end if
  if ($EVENT_PAR_ZONE_ID = 1027)
  $r0 := $r0 .or. sh_left(1, 18)
  end if
  if ($EVENT_PAR_SOURCE = 8)
  $r0 := $r0 .or. sh_left(1, 19)
  end if
  if ($EVENT_PAR_PLAY_POS = 1026)
  $r0 := $r0 .or. sh_left(1, 20)
  end if
  if ($EVENT_PAR_MIDI_CHANNEL = 11)
  $r0 := $r0 .or. sh_left(1, 21)
  end if
  if ($EVENT_PAR_MOD_VALUE_ID = 30)
  $r0 := $r0 .or. sh_left(1, 22)
  end if
  if ($EVENT_PAR_REL_VELOCITY = 27)
  $r0 := $r0 .or. sh_left(1, 23)
  end if
  if ($EVENT_PAR_CUSTOM = 28)
  $r0 := $r0 .or. sh_left(1, 24)
  end if
  if ($NI_CB_TYPE_INIT = 5)
  $r0 := $r0 .or. sh_left(1, 25)
  end if
  if ($NI_CB_TYPE_NOTE = 1)
  $r0 := $r0 .or. sh_left(1, 26)
  end if
  if ($NI_CB_TYPE_RELEASE = 2)
  $r0 := $r0 .or. sh_left(1, 27)
  end if
  if ($NI_CB_TYPE_CONTROLLER = 3)
  $r0 := $r0 .or. sh_left(1, 28)
  end if
  if ($NI_CB_TYPE_POLY_AT = 4)
  $r0 := $r0 .or. sh_left(1, 29)
  end if
  if ($NI_CB_TYPE_RPN = 10)
  $r0 := $r0 .or. sh_left(1, 30)
  end if
  if ($NI_CB_TYPE_NRPN = 11)
  $r0 := $r0 .or. sh_left(1, 31)
  end if
  if ($NI_CB_TYPE_UI_CONTROL = 6)
  $r1 := $r1 .or. sh_left(1, 0)
  end if
  if ($NI_CB_TYPE_UI_UPDATE = 7)
  $r1 := $r1 .or. sh_left(1, 1)
  end if
  if ($NI_CB_TYPE_UI_CONTROLS = 15)
  $r1 := $r1 .or. sh_left(1, 2)
  end if
  if ($NI_CB_TYPE_LISTENER = 12)
  $r1 := $r1 .or. sh_left(1, 3)
  end if
  if ($NI_CB_TYPE_PGS = 8)
  $r1 := $r1 .or. sh_left(1, 4)
  end if
  if ($NI_CB_TYPE_PERSISTENCE_CHANGED = 14)
  $r1 := $r1 .or. sh_left(1, 5)
  end if
  if ($NI_CB_TYPE_ASYNC_COMPLETE = 13)
  $r1 := $r1 .or. sh_left(1, 6)
  end if
  if ($NI_SIGNAL_TIMER_MS = 3)
  $r1 := $r1 .or. sh_left(1, 7)
  end if
  if ($NI_SIGNAL_TIMER_BEAT = 4)
  $r1 := $r1 .or. sh_left(1, 8)
  end if
  if ($NI_SIGNAL_TRANSP_START = 1)
  $r1 := $r1 .or. sh_left(1, 9)
  end if
  if ($NI_SIGNAL_TRANSP_STOP = 2)
  $r1 := $r1 .or. sh_left(1, 10)
  end if
  if ($EFFECT_TYPE_NONE = 0)
  $r1 := $r1 .or. sh_left(1, 11)
  end if
  if ($EFFECT_TYPE_COMPRESSOR = 2)
  $r1 := $r1 .or. sh_left(1, 12)
  end if
  if ($EFFECT_TYPE_LIMITER = 3)
  $r1 := $r1 .or. sh_left(1, 13)
  end if
  if ($EFFECT_TYPE_GAINER = 20)
  $r1 := $r1 .or. sh_left(1, 14)
  end if
  if ($EFFECT_TYPE_INVERTER = 4)
  $r1 := $r1 .or. sh_left(1, 15)
  end if
  if ($EFFECT_TYPE_SURROUND_PANNER = 5)
  $r1 := $r1 .or. sh_left(1, 16)
  end if
  if ($EFFECT_TYPE_SHAPER = 6)
  $r1 := $r1 .or. sh_left(1, 17)
  end if
  if ($EFFECT_TYPE_FILTER = 7)
  $r1 := $r1 .or. sh_left(1, 18)
  end if
  if ($EFFECT_TYPE_LOFI = 8)
  $r1 := $r1 .or. sh_left(1, 19)
  end if
  if ($EFFECT_TYPE_STEREO = 9)
  $r1 := $r1 .or. sh_left(1, 20)
  end if
  if ($EFFECT_TYPE_DISTORTION = 10)
  $r1 := $r1 .or. sh_left(1, 21)
  end if
  if ($EFFECT_TYPE_SEND_LEVELS = 11)
  $r1 := $r1 .or. sh_left(1, 22)
  end if
  if ($EFFECT_TYPE_PHASER = 14)
  $r1 := $r1 .or. sh_left(1, 23)
  end if
  if ($EFFECT_TYPE_FLANGER = 15)
  $r1 := $r1 .or. sh_left(1, 24)
  end if
  if ($EFFECT_TYPE_CHORUS = 16)
  $r1 := $r1 .or. sh_left(1, 25)
  end if
  if ($EFFECT_TYPE_PHASIS = 41)
  $r1 := $r1 .or. sh_left(1, 26)
  end if
  if ($EFFECT_TYPE_FLAIR = 42)
  $r1 := $r1 .or. sh_left(1, 27)
  end if
  if ($NI_FLAIR_MODE_STANDARD = 0)
  $r1 := $r1 .or. sh_left(1, 28)
  end if
  if ($NI_FLAIR_MODE_THRU_ZERO = 1)
  $r1 := $r1 .or. sh_left(1, 29)
  end if
  if ($NI_FLAIR_MODE_SCAN = 2)
  $r1 := $r1 .or. sh_left(1, 30)
  end if
  if ($NI_FLAIR_SCANMODE_TRIANGLE = 0)
  $r1 := $r1 .or. sh_left(1, 31)
  end if
  $cv := $r0
  $cb := 0
  while ($cb < 32)
    if ((sh_right($cv, $cb) mod 2) # 0)
      set_engine_par($ENGINE_PAR_VOLUME, 1000, $cb + 0, -1, -1)
    end if
    inc($cb)
  end while
  $cv := $r1
  $cb := 0
  while ($cb < 32)
    if ((sh_right($cv, $cb) mod 2) # 0)
      set_engine_par($ENGINE_PAR_VOLUME, 1000, $cb + 32, -1, -1)
    end if
    inc($cb)
  end while
  set_engine_par($ENGINE_PAR_VOLUME, 1000, 65, -1, -1)
end on
