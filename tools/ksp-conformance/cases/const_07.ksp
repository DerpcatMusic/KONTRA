on init
  declare $cv
  declare $cb
  set_engine_par($ENGINE_PAR_VOLUME, 1000, 64, -1, -1)
  declare $r0 := 0
  declare $r1 := 0
  if ($NI_MOUSE_EVENT_TYPE_LEFT_BUTTON_DOWN = 1)
  $r0 := $r0 .or. sh_left(1, 0)
  end if
  if ($NI_MOUSE_EVENT_TYPE_LEFT_BUTTON_UP = 2)
  $r0 := $r0 .or. sh_left(1, 1)
  end if
  if ($NI_RAUM_TYPE_AIRY = 1)
  $r0 := $r0 .or. sh_left(1, 2)
  end if
  if ($NI_RAUM_TYPE_COSMIC = 2)
  $r0 := $r0 .or. sh_left(1, 3)
  end if
  if ($NI_RAUM_TYPE_GROUNDED = 0)
  $r0 := $r0 .or. sh_left(1, 4)
  end if
  if ($NI_REPLIKA_TYPE_ANALOGUE = 1)
  $r0 := $r0 .or. sh_left(1, 5)
  end if
  if ($NI_REPLIKA_TYPE_DIFFUSION = 4)
  $r0 := $r0 .or. sh_left(1, 6)
  end if
  if ($NI_REPLIKA_TYPE_MODERN = 0)
  $r0 := $r0 .or. sh_left(1, 7)
  end if
  if ($NI_REPLIKA_TYPE_TAPE = 2)
  $r0 := $r0 .or. sh_left(1, 8)
  end if
  if ($NI_REPLIKA_TYPE_VINTAGE = 3)
  $r0 := $r0 .or. sh_left(1, 9)
  end if
  if ($NI_RINGMOD_LFO_WAVE_SINE = 0)
  $r0 := $r0 .or. sh_left(1, 10)
  end if
  if ($NI_RINGMOD_LFO_WAVE_SQUARE = 1)
  $r0 := $r0 .or. sh_left(1, 11)
  end if
  if ($NI_SHAPE_TYPE_CLASSIC = 0)
  $r0 := $r0 .or. sh_left(1, 12)
  end if
  if ($NI_SHAPE_TYPE_DRUMS = 1)
  $r0 := $r0 .or. sh_left(1, 13)
  end if
  if ($NI_SHAPE_TYPE_ENHANCED = 2)
  $r0 := $r0 .or. sh_left(1, 14)
  end if
  if ($NI_SKDLX_MODE_CLASSIC = 0)
  $r0 := $r0 .or. sh_left(1, 15)
  end if
  if ($NI_SKDLX_MODE_EQ = 2)
  $r0 := $r0 .or. sh_left(1, 16)
  end if
  if ($NI_SKDLX_MODE_LED = 1)
  $r0 := $r0 .or. sh_left(1, 17)
  end if
  if ($NI_SOURCE_MODE_BEAT_MACHINE = 5)
  $r0 := $r0 .or. sh_left(1, 18)
  end if
  if ($NI_SOURCE_MODE_DFD = 4)
  $r0 := $r0 .or. sh_left(1, 19)
  end if
  if ($NI_SOURCE_MODE_SAMPLER = 0)
  $r0 := $r0 .or. sh_left(1, 20)
  end if
  if ($NI_SOURCE_MODE_TIME_MACHINE_PRO = 9)
  $r0 := $r0 .or. sh_left(1, 21)
  end if
  if ($NI_SOURCE_MODE_TONE_MACHINE = 1)
  $r0 := $r0 .or. sh_left(1, 22)
  end if
  if ($NI_SOURCE_MODE_WAVETABLE = 2)
  $r0 := $r0 .or. sh_left(1, 23)
  end if
  if ($NI_SUPERGT_CHANNEL_LINK_MODE_DUAL_MONO = 1)
  $r0 := $r0 .or. sh_left(1, 24)
  end if
  if ($NI_SUPERGT_CHANNEL_LINK_MODE_MS = 2)
  $r0 := $r0 .or. sh_left(1, 25)
  end if
  if ($NI_SUPERGT_CHANNEL_LINK_MODE_STEREO = 0)
  $r0 := $r0 .or. sh_left(1, 26)
  end if
  if ($NI_SUPERGT_CHAR_MODE_BRIGHT = 2)
  $r0 := $r0 .or. sh_left(1, 27)
  end if
  if ($NI_SUPERGT_CHAR_MODE_FAT = 0)
  $r0 := $r0 .or. sh_left(1, 28)
  end if
  if ($NI_SUPERGT_CHAR_MODE_WARM = 1)
  $r0 := $r0 .or. sh_left(1, 29)
  end if
  if ($NI_SUPERGT_HPF_MODE_OFF = 0)
  $r0 := $r0 .or. sh_left(1, 30)
  end if
  if ($NI_SUPERGT_SAT_MODE_HOT = 2)
  $r0 := $r0 .or. sh_left(1, 31)
  end if
  if ($NI_SUPERGT_SAT_MODE_MILD = 0)
  $r1 := $r1 .or. sh_left(1, 0)
  end if
  if ($NI_SUPERGT_SAT_MODE_MODERATE = 1)
  $r1 := $r1 .or. sh_left(1, 1)
  end if
  if ($NI_SYNC_UNIT_ZONE = 22)
  $r1 := $r1 .or. sh_left(1, 2)
  end if
  if ($NI_VC_COLOR_TYPE_A = 0)
  $r1 := $r1 .or. sh_left(1, 3)
  end if
  if ($NI_VC_COLOR_TYPE_B = 1)
  $r1 := $r1 .or. sh_left(1, 4)
  end if
  if ($NI_VC_COLOR_TYPE_C = 2)
  $r1 := $r1 .or. sh_left(1, 5)
  end if
  if ($NI_VL_TMPRO_STANDARD = 0)
  $r1 := $r1 .or. sh_left(1, 6)
  end if
  if ($NI_WT_MOD_WAVE_SINE = 0)
  $r1 := $r1 .or. sh_left(1, 7)
  end if
  if ($NI_WT_MOD_WAVE_TRIANGLE = 1)
  $r1 := $r1 .or. sh_left(1, 8)
  end if
  if ($EVENT_PAR_MOD_VALUE_EX_ID = 34)
  $r1 := $r1 .or. sh_left(1, 9)
  end if
  if ($EVENT_PAR_MOD_VALUE_EX_IDX = 33)
  $r1 := $r1 .or. sh_left(1, 10)
  end if
  if ($MIDI_COMMAND_NRPN = 48)
  $r1 := $r1 .or. sh_left(1, 11)
  end if
  if ($MIDI_COMMAND_RPN = 32)
  $r1 := $r1 .or. sh_left(1, 12)
  end if
  if ($NI_DETECT_DRUM_TYPE_CLAP = 6)
  $r1 := $r1 .or. sh_left(1, 13)
  end if
  if ($NI_DETECT_DRUM_TYPE_CLOSED_HH = 2)
  $r1 := $r1 .or. sh_left(1, 14)
  end if
  if ($NI_DETECT_DRUM_TYPE_CYMBAL = 5)
  $r1 := $r1 .or. sh_left(1, 15)
  end if
  if ($NI_DETECT_DRUM_TYPE_INVALID = -1)
  $r1 := $r1 .or. sh_left(1, 16)
  end if
  if ($NI_DETECT_DRUM_TYPE_KICK = 0)
  $r1 := $r1 .or. sh_left(1, 17)
  end if
  if ($NI_DETECT_DRUM_TYPE_OPEN_HH = 3)
  $r1 := $r1 .or. sh_left(1, 18)
  end if
  if ($NI_DETECT_DRUM_TYPE_PERC_DRUM = 8)
  $r1 := $r1 .or. sh_left(1, 19)
  end if
  if ($NI_DETECT_DRUM_TYPE_PERC_OTHER = 9)
  $r1 := $r1 .or. sh_left(1, 20)
  end if
  if ($NI_DETECT_DRUM_TYPE_SHAKER = 7)
  $r1 := $r1 .or. sh_left(1, 21)
  end if
  if ($NI_DETECT_DRUM_TYPE_SNARE = 1)
  $r1 := $r1 .or. sh_left(1, 22)
  end if
  if ($NI_DETECT_DRUM_TYPE_TOM = 4)
  $r1 := $r1 .or. sh_left(1, 23)
  end if
  if ($NI_DETECT_INSTRUMENT_TYPE_BASS = 0)
  $r1 := $r1 .or. sh_left(1, 24)
  end if
  if ($NI_DETECT_INSTRUMENT_TYPE_BOWED_STRING = 1)
  $r1 := $r1 .or. sh_left(1, 25)
  end if
  if ($NI_DETECT_INSTRUMENT_TYPE_BRASS = 2)
  $r1 := $r1 .or. sh_left(1, 26)
  end if
  if ($NI_DETECT_INSTRUMENT_TYPE_FLUTE = 3)
  $r1 := $r1 .or. sh_left(1, 27)
  end if
  if ($NI_DETECT_INSTRUMENT_TYPE_GUITAR = 4)
  $r1 := $r1 .or. sh_left(1, 28)
  end if
  if ($NI_DETECT_INSTRUMENT_TYPE_INVALID = -1)
  $r1 := $r1 .or. sh_left(1, 29)
  end if
  if ($NI_DETECT_INSTRUMENT_TYPE_KEYBOARD = 5)
  $r1 := $r1 .or. sh_left(1, 30)
  end if
  if ($NI_DETECT_INSTRUMENT_TYPE_MALLET = 6)
  $r1 := $r1 .or. sh_left(1, 31)
  end if
  $cv := $r0
  $cb := 0
  while ($cb < 32)
    if ((sh_right($cv, $cb) mod 2) # 0)
      set_engine_par($ENGINE_PAR_VOLUME, 1000, $cb + 0, -1, -1)
    end if
    inc($cb)
  end while
  $cv := $r1
  $cb := 0
  while ($cb < 32)
    if ((sh_right($cv, $cb) mod 2) # 0)
      set_engine_par($ENGINE_PAR_VOLUME, 1000, $cb + 32, -1, -1)
    end if
    inc($cb)
  end while
  set_engine_par($ENGINE_PAR_VOLUME, 1000, 65, -1, -1)
end on
