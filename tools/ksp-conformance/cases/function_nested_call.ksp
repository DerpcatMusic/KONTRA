function inner()
  $g := $g + 10
end function
function outer()
  call inner()
  $g := $g * 2
end function
on init
  declare $cv
  declare $cb
  declare $g := 2
  call outer()
  $cv := $g
  $cb := 0
  while ($cb < 32)
    if ((sh_right($cv, $cb) mod 2) # 0)
      set_engine_par($ENGINE_PAR_VOLUME, 1000, $cb + 0, -1, -1)
    end if
    inc($cb)
  end while
end on
