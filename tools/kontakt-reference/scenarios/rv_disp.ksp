on init
declare $i
declare ui_button $go
move_control_px($go,5,5)
declare ui_label $n0(1,1)
set_text($n0,"time")
declare ui_label $v0_0(1,1)
declare ui_label $v0_1(1,1)
declare ui_label $v0_2(1,1)
declare ui_label $v0_3(1,1)
declare ui_label $v0_4(1,1)
declare ui_label $n1(1,1)
set_text($n1,"size")
declare ui_label $v1_0(1,1)
declare ui_label $v1_1(1,1)
declare ui_label $v1_2(1,1)
declare ui_label $v1_3(1,1)
declare ui_label $v1_4(1,1)
declare ui_label $n2(1,1)
set_text($n2,"damp")
declare ui_label $v2_0(1,1)
declare ui_label $v2_1(1,1)
declare ui_label $v2_2(1,1)
declare ui_label $v2_3(1,1)
declare ui_label $v2_4(1,1)
declare ui_label $n3(1,1)
set_text($n3,"diff")
declare ui_label $v3_0(1,1)
declare ui_label $v3_1(1,1)
declare ui_label $v3_2(1,1)
declare ui_label $v3_3(1,1)
declare ui_label $v3_4(1,1)
declare ui_label $n4(1,1)
set_text($n4,"pre")
declare ui_label $v4_0(1,1)
declare ui_label $v4_1(1,1)
declare ui_label $v4_2(1,1)
declare ui_label $v4_3(1,1)
declare ui_label $v4_4(1,1)
declare ui_label $n5(1,1)
set_text($n5,"hicut")
declare ui_label $v5_0(1,1)
declare ui_label $v5_1(1,1)
declare ui_label $v5_2(1,1)
declare ui_label $v5_3(1,1)
declare ui_label $v5_4(1,1)
declare ui_label $n6(1,1)
set_text($n6,"lowsh")
declare ui_label $v6_0(1,1)
declare ui_label $v6_1(1,1)
declare ui_label $v6_2(1,1)
declare ui_label $v6_3(1,1)
declare ui_label $v6_4(1,1)
declare ui_label $n7(1,1)
set_text($n7,"stereo")
declare ui_label $v7_0(1,1)
declare ui_label $v7_1(1,1)
declare ui_label $v7_2(1,1)
declare ui_label $v7_3(1,1)
declare ui_label $v7_4(1,1)
declare ui_label $n8(1,1)
set_text($n8,"mod")
declare ui_label $v8_0(1,1)
declare ui_label $v8_1(1,1)
declare ui_label $v8_2(1,1)
declare ui_label $v8_3(1,1)
declare ui_label $v8_4(1,1)
end on
on ui_control($go)
set_engine_par($ENGINE_PAR_SEND_EFFECT_TYPE,$EFFECT_TYPE_REVERB2,-1,0,-1)
wait(200000)
$i := 0
while ($i < 5)
set_engine_par($ENGINE_PAR_RV2_TIME,$i*250000,-1,0,-1)
set_engine_par($ENGINE_PAR_RV2_SIZE,$i*250000,-1,0,-1)
set_engine_par($ENGINE_PAR_RV2_DAMPING,$i*250000,-1,0,-1)
set_engine_par($ENGINE_PAR_RV2_DIFF,$i*250000,-1,0,-1)
set_engine_par($ENGINE_PAR_RV2_PREDELAY,$i*250000,-1,0,-1)
set_engine_par($ENGINE_PAR_RV2_HIGHCUT,$i*250000,-1,0,-1)
set_engine_par($ENGINE_PAR_RV2_LOWSHELF,$i*250000,-1,0,-1)
set_engine_par($ENGINE_PAR_RV2_STEREO,$i*250000,-1,0,-1)
set_engine_par($ENGINE_PAR_RV2_MOD,$i*250000,-1,0,-1)
wait(200000)
if ($i = 0)
set_text($v0_0,get_engine_par_disp($ENGINE_PAR_RV2_TIME,-1,0,-1))
set_text($v1_0,get_engine_par_disp($ENGINE_PAR_RV2_SIZE,-1,0,-1))
set_text($v2_0,get_engine_par_disp($ENGINE_PAR_RV2_DAMPING,-1,0,-1))
set_text($v3_0,get_engine_par_disp($ENGINE_PAR_RV2_DIFF,-1,0,-1))
set_text($v4_0,get_engine_par_disp($ENGINE_PAR_RV2_PREDELAY,-1,0,-1))
set_text($v5_0,get_engine_par_disp($ENGINE_PAR_RV2_HIGHCUT,-1,0,-1))
set_text($v6_0,get_engine_par_disp($ENGINE_PAR_RV2_LOWSHELF,-1,0,-1))
set_text($v7_0,get_engine_par_disp($ENGINE_PAR_RV2_STEREO,-1,0,-1))
set_text($v8_0,get_engine_par_disp($ENGINE_PAR_RV2_MOD,-1,0,-1))
end if
if ($i = 1)
set_text($v0_1,get_engine_par_disp($ENGINE_PAR_RV2_TIME,-1,0,-1))
set_text($v1_1,get_engine_par_disp($ENGINE_PAR_RV2_SIZE,-1,0,-1))
set_text($v2_1,get_engine_par_disp($ENGINE_PAR_RV2_DAMPING,-1,0,-1))
set_text($v3_1,get_engine_par_disp($ENGINE_PAR_RV2_DIFF,-1,0,-1))
set_text($v4_1,get_engine_par_disp($ENGINE_PAR_RV2_PREDELAY,-1,0,-1))
set_text($v5_1,get_engine_par_disp($ENGINE_PAR_RV2_HIGHCUT,-1,0,-1))
set_text($v6_1,get_engine_par_disp($ENGINE_PAR_RV2_LOWSHELF,-1,0,-1))
set_text($v7_1,get_engine_par_disp($ENGINE_PAR_RV2_STEREO,-1,0,-1))
set_text($v8_1,get_engine_par_disp($ENGINE_PAR_RV2_MOD,-1,0,-1))
end if
if ($i = 2)
set_text($v0_2,get_engine_par_disp($ENGINE_PAR_RV2_TIME,-1,0,-1))
set_text($v1_2,get_engine_par_disp($ENGINE_PAR_RV2_SIZE,-1,0,-1))
set_text($v2_2,get_engine_par_disp($ENGINE_PAR_RV2_DAMPING,-1,0,-1))
set_text($v3_2,get_engine_par_disp($ENGINE_PAR_RV2_DIFF,-1,0,-1))
set_text($v4_2,get_engine_par_disp($ENGINE_PAR_RV2_PREDELAY,-1,0,-1))
set_text($v5_2,get_engine_par_disp($ENGINE_PAR_RV2_HIGHCUT,-1,0,-1))
set_text($v6_2,get_engine_par_disp($ENGINE_PAR_RV2_LOWSHELF,-1,0,-1))
set_text($v7_2,get_engine_par_disp($ENGINE_PAR_RV2_STEREO,-1,0,-1))
set_text($v8_2,get_engine_par_disp($ENGINE_PAR_RV2_MOD,-1,0,-1))
end if
if ($i = 3)
set_text($v0_3,get_engine_par_disp($ENGINE_PAR_RV2_TIME,-1,0,-1))
set_text($v1_3,get_engine_par_disp($ENGINE_PAR_RV2_SIZE,-1,0,-1))
set_text($v2_3,get_engine_par_disp($ENGINE_PAR_RV2_DAMPING,-1,0,-1))
set_text($v3_3,get_engine_par_disp($ENGINE_PAR_RV2_DIFF,-1,0,-1))
set_text($v4_3,get_engine_par_disp($ENGINE_PAR_RV2_PREDELAY,-1,0,-1))
set_text($v5_3,get_engine_par_disp($ENGINE_PAR_RV2_HIGHCUT,-1,0,-1))
set_text($v6_3,get_engine_par_disp($ENGINE_PAR_RV2_LOWSHELF,-1,0,-1))
set_text($v7_3,get_engine_par_disp($ENGINE_PAR_RV2_STEREO,-1,0,-1))
set_text($v8_3,get_engine_par_disp($ENGINE_PAR_RV2_MOD,-1,0,-1))
end if
if ($i = 4)
set_text($v0_4,get_engine_par_disp($ENGINE_PAR_RV2_TIME,-1,0,-1))
set_text($v1_4,get_engine_par_disp($ENGINE_PAR_RV2_SIZE,-1,0,-1))
set_text($v2_4,get_engine_par_disp($ENGINE_PAR_RV2_DAMPING,-1,0,-1))
set_text($v3_4,get_engine_par_disp($ENGINE_PAR_RV2_DIFF,-1,0,-1))
set_text($v4_4,get_engine_par_disp($ENGINE_PAR_RV2_PREDELAY,-1,0,-1))
set_text($v5_4,get_engine_par_disp($ENGINE_PAR_RV2_HIGHCUT,-1,0,-1))
set_text($v6_4,get_engine_par_disp($ENGINE_PAR_RV2_LOWSHELF,-1,0,-1))
set_text($v7_4,get_engine_par_disp($ENGINE_PAR_RV2_STEREO,-1,0,-1))
set_text($v8_4,get_engine_par_disp($ENGINE_PAR_RV2_MOD,-1,0,-1))
end if
inc($i)
end while
end on
