{ Synthetic own source, no library/bank/sample/native fixture. }
on init
    pgs_create_key(RPN_NKA_START, 1)
    declare %data[1] := (7)
    declare $m
    declare $a
    declare $done
    declare $async
end on
on note
    ignore_event($EVENT_ID)
    set_rpn(0, 16383)
    $m := mf_reset()
    wait_async($m)
    set_nrpn(16383, 0)
    pgs_set_key_val(RPN_NKA_START, 0, 1)
end on
{ NKA jobs require an approved callback; on note is deliberately rejected. }
on pgs_changed
    $a := save_array_str(%data, "/rpn-synthetic-neighbor.nka")
    wait_async($a)
    $done := 42
end on
on async_complete
    inc($async)
end on
