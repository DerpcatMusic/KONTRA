<!-- Source-free authored UVI table separator and edit fixture. -->
<UVI4><Program Name="Table separators"><EventProcessors><ScriptProcessor><script><![CDATA[
setSize(320,160)
local bars=Table('Bars',4,1,0,1,false)
default_edge=bars.drawInnerEdge
bars.bounds={12,12,120,80}
bars.backgroundColour='black'
bars.sliderColour='white'
bars.innerEdgeColour='red'
calls=0
bars.changed=function(self,index)
  calls=calls+1
  last_index=index
  last_value=self:getValue(index)
end
local toggle=OnOffButton('Edges',false)
toggle.bounds={160,12,100,25}
toggle.changed=function(self)
  bars.drawInnerEdge=not self.value
  bars.innerEdgeColour='#0000ff'
end
]]></script></ScriptProcessor></EventProcessors></Program></UVI4>
