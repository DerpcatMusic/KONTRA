local ui = require("native_ui")
local kontakt = require("kontakt")
local context=require("context")
return function(props)
    local inherited=ui.use_context(context.primary)
    local secondary=ui.use_context(context.secondary)
    assert(inherited()==(props.parameter_id=="Remote" and "remote" or "inherited"),"nearest context reaches lazy child")
    assert(secondary()=="second","distinct parent context key remains visible")
    local parameter = kontakt.connect_parameter(props.parameter_id)
    local count, set_count = ui.create_state(0)
    local label = ui.create_computed(function()
        return string.format("%s:%.6f:%d",props.parameter_id,parameter:value(),count())
    end)
    return @ui.Text {text=label}.frame(width=180,height=24)
        .on_tap_gesture(start=function(event)
            assert(event.kind=="tap")
            parameter:set_value(parameter:value()+0.05)
            set_count(count()+1)
        end)
end
