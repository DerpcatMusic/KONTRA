local ui = require("native_ui")
local util = require("native_ui_util")
local nested={value=1}
local original=setmetatable({[1]="first",[3]="third",field=false,nested=nested}, {__index={inherited=true}})
local copy=table.shallow_copy(original)
assert(copy~=original and copy[1]=="first" and copy[2]==nil and copy[3]=="third")
assert(copy.field==false and copy.nested==nested and copy.inherited==nil)
copy.nested.value=2
assert(original.nested.value==2)
assert(util.clamp(-2,0,10)==0 and util.clamp(6,0,10)==6 and util.clamp(11,0,10)==10)
local bound=util.partial(function(...) return table.pack(...), "multiple",nil end, false,nil)
local args,marker,last=bound(5,nil)
assert(args.n==4 and args[1]==false and args[2]==nil and args[3]==5 and args[4]==nil)
assert(marker=="multiple" and last==nil)
assert(not pcall(function() return util.unsupported() end))

local connected,kontakt=pcall(require,"kontakt")
assert(connected and kontakt.connect_parameter)
local remote=kontakt.connect_parameter("Remote")
local tint=ui.Color(0xFF0A141E):opacity(0.25):opacity(0.5)
assert(tint.r==10 and tint.g==20 and tint.b==30 and tint.a==0.5)
assert(ui.Color.white:opacity(0).a==0 and ui.Color.white.a==1)
local optional_style={text_color=ui.Color.__authored_missing_color}
assert(optional_style.text_color==nil)
assert((optional_style.text_color or ui.Color.white)==ui.Color.white)
assert(not pcall(function() return ui.Color.__authored_missing_color() end))
assert(not pcall(function() return ui.Color.white:__authored_missing_method() end))
local Card = require("components")
local context=require("context")
return function()
    return @ui.ZStack {
        @ui.Rectangle {color=
            tint}
        true and -- an authored conditional may continue after its comment
        @Card {parameter_id="Amount"}
        or @ui.ZStack {}
        @Card {parameter_id="Remote"}.font_size(20).foreground_color(ui.Color.red).context(key=context.primary,value="remote").hidden(ui.create_computed(function() return remote:value()>=20 end))
        @ui.Image {file=ui.create_computed(function()
            return remote:value()<20 and "assets/pics/ready.svg" or "assets/pics/changed.svg"
        end),resizable=false}.padding(left=4,right=6,top=8,bottom=2).frame(width=100,height=60,alignment="top left").frame(width=300,height=160,alignment="bottom right")
    }.font_size(12).foreground_color(tint).context(key=context.primary,value="inherited").context(key=context.secondary,value="second").frame(width=640 height=400)
end
